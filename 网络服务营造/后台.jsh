# 后台 —— 为已注册模型自动生成的简易管理后台（admin）
# 用法：
#   网造.后台_配置({"标题":"我的后台", "用户":"admin", "口令":"你的密码"})
#   网造.后台_挂载(路由, "/后台")
# 需要：会话中间件（登录态）。所有页面（登录/登出除外）都要登录。
# 顶层名字统一 后台_ 前缀。

导入 编码

后台_设置 = {"标题": "管理后台", "用户": "admin", "口令哈希": "", "前缀": "/后台", "每页": 20, "关系": {}, "上传目录": ""}

函数 后台_配置(选项 = 空):
    如果 选项 != 空:
        后台_设置["标题"] = 选项.获取("标题", 后台_设置["标题"])
        后台_设置["用户"] = 选项.获取("用户", 后台_设置["用户"])
        后台_设置["每页"] = 选项.获取("每页", 后台_设置["每页"])
        后台_设置["前缀"] = 选项.获取("前缀", 后台_设置["前缀"])
        后台_设置["上传目录"] = 选项.获取("上传目录", 后台_设置["上传目录"])
        如果 选项.包含("关系"):
            后台_设置["关系"] = 选项["关系"]
        如果 选项.包含("口令"):
            令 明文 = 文本(选项["口令"])
            如果 明文.包含("$"):
                后台_设置["口令哈希"] = 明文
            否则:
                后台_设置["口令哈希"] = 认证_哈希(明文)

# 把后台路由挂到一张路由表上
函数 后台_挂载(路由, 前缀 = 空):
    如果 前缀 == 空:
        前缀 = 后台_设置["前缀"]
    后台_设置["前缀"] = 前缀
    # 注意：路由表会把请求路径末尾的 / 去掉，所以这里注册都不要带尾部 /
    路由.加(前缀, 后台_首页, ["GET"], "后台首页")
    路由.加(前缀 + "/登录", 后台_登录, ["GET", "POST"])
    路由.加(前缀 + "/登出", 后台_登出, ["GET"])
    路由.加(前缀 + "/图片", 后台_图片列表, ["GET"])
    路由.加(前缀 + "/图片/删除", 后台_图片删除, ["POST"])
    路由.加(前缀 + "/<模型>", 后台_列表, ["GET"])
    路由.加(前缀 + "/<模型>/新建", 后台_新建, ["GET", "POST"])
    路由.加(前缀 + "/<模型>/导出", 后台_导出CSV, ["GET"])
    路由.加(前缀 + "/<模型>/批量删除", 后台_批量删除, ["POST"])
    路由.加(前缀 + "/<模型>/<int:id>/删除", 后台_删除, ["POST"])
    路由.加(前缀 + "/<模型>/<int:id>", 后台_编辑, ["GET", "POST"])
    返回 路由

# ---- 内部工具 ----
函数 后台_守卫(请求):
    如果 非 认证_已登录(请求):
        返回 重定向(后台_设置["前缀"] + "/登录")
    返回 空

函数 后台_有模型(名):
    返回 模型_有(名)

# ---- 登录 / 登出 ----
函数 后台_登录表单(错误):
    令 h = []
    如果 错误 != "":
        h.追加("<div class=\"错误\">" + 内建_转义(错误) + "</div>")
    h.追加("<form method=\"post\" action=\"" + 后台_设置["前缀"] + "/登录\">")
    h.追加("<div class=\"字段\"><label>口令</label><input type=\"password\" name=\"口令\" autofocus></div>")
    h.追加("<button type=\"submit\">登录</button></form>")
    返回 内建_拼接(h, "")

函数 后台_登录(请求, 参数):
    如果 请求.是GET():
        返回 响应(后台_页面("登录", 后台_登录表单("")))
    令 f = 请求.取表单()
    令 口令 = f.获取("口令", "")
    如果 认证_校验(口令, 后台_设置["口令哈希"]):
        认证_登录(请求, {"名": 后台_设置["用户"], "角色": "管理员"})
        返回 重定向(后台_设置["前缀"] + "/")
    返回 响应(后台_页面("登录", 后台_登录表单("口令不对，请重试")))

函数 后台_登出(请求, 参数):
    认证_登出(请求)
    返回 重定向(后台_设置["前缀"] + "/登录")

# ---- 页面 ----
函数 后台_首页(请求, 参数):
    令 g = 后台_守卫(请求)
    如果 g != 空:
        返回 g
    令 前缀 = 后台_设置["前缀"]
    令 项 = []
    遍历 m 在 模型_模型们():
        令 n = 模型_计数(m)
        项.追加("<li><a href=\"" + 前缀 + "/" + 编码.url编码(m) + "/\">" + 内建_转义(m) + "</a><span class=\"弱\">" + 文本(n) + " 条</span></li>")
    令 内容 = "<ul class=\"模型列表\">" + 内建_拼接(项, "") + "</ul>"
    返回 响应(后台_页面("模型", 内容))

函数 后台_图片列表(请求, 参数):
    令 g = 后台_守卫(请求)
    如果 g != 空:
        返回 g
    令 前缀 = 后台_设置["前缀"]
    令 目录 = 后台_设置["上传目录"]
    如果 目录 == "":
        返回 响应(后台_页面("图片", "<p class=\"弱\">未配置上传目录（后台_配置 里设 上传目录）。</p>"))
    令 图片们 = 上传_读索引(目录)
    令 h = ["<div class=\"图片网格\">"]
    如果 长度(图片们) == 0:
        h.追加("<p class=\"弱\">还没有上传图片。</p>")
    遍历 图 在 图片们:
        令 名 = 内建_文本(图["名"])
        h.追加("<div class=\"图片卡\">")
        # 索引里有 网址（0.3.6 起静态可发二进制，图片用文件 URL）就用网址；旧记录回退 dataURL
        令 网址 = 内建_文本(图.获取("网址", ""))
        如果 网址 != "":
            h.追加("<img src=\"" + 内建_转义(网址) + "\">")
        否则:
            h.追加("<img src=\"" + 内建_文本(图["预览"]) + "\">")
        h.追加("<div class=\"图片名\">" + 内建_转义(名) + "</div>")
        h.追加("<form method=\"post\" action=\"" + 前缀 + "/图片/删除\" style=\"display:inline\"><input type=\"hidden\" name=\"名\" value=\"" + 内建_转义(名) + "\"><button type=\"submit\" class=\"链接按钮\" onclick=\"return confirm('确定删除？')\">删除</button></form>")
        h.追加("</div>")
    h.追加("</div>")
    返回 响应(后台_页面("图片", 内建_拼接(h, "")))

函数 后台_图片删除(请求, 参数):
    令 g = 后台_守卫(请求)
    如果 g != 空:
        返回 g
    令 目录 = 后台_设置["上传目录"]
    令 名 = 请求.取表单().获取("名", "")
    令 图片们 = 上传_读索引(目录)
    令 新们 = []
    遍历 图 在 图片们:
        如果 内建_文本(图["名"]) != 名:
            新们.追加(图)
        否则:
            尝试:
                文件.删除文件(图["路径"])
            捕获 异常 为 e:
                令 _ = e
    上传_写索引(目录, 新们)
    返回 重定向(后台_设置["前缀"] + "/图片")

函数 后台_列表(请求, 参数):
    令 g = 后台_守卫(请求)
    如果 g != 空:
        返回 g
    令 名 = 参数["模型"]
    如果 非 后台_有模型(名):
        返回 未找到("没有这个模型")
    令 定义 = 模型_取定义(名)
    令 前缀 = 后台_设置["前缀"]
    令 页 = 整数(请求.查询取("页", "1"))
    令 关键词 = 请求.查询取("关键词", "")
    令 排序 = 请求.查询取("排序", "")
    令 倒序 = (请求.查询取("倒序", "") == "1")

    令 全部 = 模型_全部(名)
    如果 关键词 != "":
        全部 = 后台_搜索(全部, 关键词, 定义["字段们"])
    如果 排序 != "":
        全部 = 后台_排序(全部, 排序, 倒序)

    令 关系 = 后台_设置["关系"].获取(名, {})
    令 从缓存 = 后台_建关系缓存(关系)
    令 分页 = 后台_分页切片(全部, 页, 后台_设置["每页"])

    令 基 = 前缀 + "/" + 编码.url编码(名) + "/"
    令 引号 = 字符(34)
    令 工具条 = "<div class=" + 引号 + "工具条" + 引号 + ">"
    工具条 = 工具条 + "<a class=" + 引号 + "按钮" + 引号 + " href=" + 引号 + 基 + "新建" + 引号 + ">新建</a> "
    工具条 = 工具条 + "<a class=" + 引号 + "按钮 次" + 引号 + " href=" + 引号 + 基 + "导出" + 引号 + ">导出 CSV</a> "
    工具条 = 工具条 + "<button type=" + 引号 + "button" + 引号 + " class=" + 引号 + "按钮 危险" + 引号 + " data-url=" + 引号 + 基 + "批量删除" + 引号 + " onclick=" + 引号 + "批量删除(this)" + 引号 + ">删除选中</button>"
    工具条 = 工具条 + "</div>" + 后台_批量脚本()
    令 内容 = 后台_搜索框(名, 关键词, 排序, 倒序) + 工具条
    内容 = 内容 + 后台_表格(名, 定义, 分页["记录们"], 关系, 从缓存, 排序, 倒序, 关键词)
    内容 = 内容 + 后台_分页html(名, 分页, 关键词, 排序, 倒序)
    返回 响应(后台_页面(名, 内容))

函数 后台_新建(请求, 参数):
    令 g = 后台_守卫(请求)
    如果 g != 空:
        返回 g
    令 名 = 参数["模型"]
    如果 非 后台_有模型(名):
        返回 未找到("没有这个模型")
    令 定义 = 模型_取定义(名)
    令 前缀 = 后台_设置["前缀"]
    令 提交到 = 前缀 + "/" + 编码.url编码(名) + "/新建"
    令 关系 = 后台_设置["关系"].获取(名, {})
    令 从缓存 = 后台_建关系缓存(关系)
    如果 请求.是GET():
        返回 响应(后台_页面("新建 · " + 名, 后台_表单html(定义, 空, 提交到, "创建", 关系, 从缓存)))
    令 记录 = 请求.取表单()
    模型_创建(名, 后台_规整(名, 记录))
    返回 重定向(前缀 + "/" + 编码.url编码(名) + "/")

函数 后台_编辑(请求, 参数):
    令 g = 后台_守卫(请求)
    如果 g != 空:
        返回 g
    令 名 = 参数["模型"]
    令 id = 参数["id"]
    如果 非 后台_有模型(名):
        返回 未找到("没有这个模型")
    令 定义 = 模型_取定义(名)
    令 记录 = 模型_取ID(名, id)
    如果 记录 == 空:
        返回 未找到("记录不存在")
    令 前缀 = 后台_设置["前缀"]
    令 提交到 = 前缀 + "/" + 编码.url编码(名) + "/" + 文本(id)
    令 关系 = 后台_设置["关系"].获取(名, {})
    令 从缓存 = 后台_建关系缓存(关系)
    如果 请求.是GET():
        返回 响应(后台_页面("编辑 · " + 名, 后台_表单html(定义, 记录, 提交到, "保存", 关系, 从缓存)))
    令 新值 = 请求.取表单()
    新值["id"] = id
    模型_保存(名, 后台_规整(名, 新值))
    返回 重定向(前缀 + "/" + 编码.url编码(名) + "/")

函数 后台_删除(请求, 参数):
    令 g = 后台_守卫(请求)
    如果 g != 空:
        返回 g
    令 名 = 参数["模型"]
    令 id = 参数["id"]
    如果 非 后台_有模型(名):
        返回 未找到("没有这个模型")
    模型_删除ID(名, id)
    返回 重定向(后台_设置["前缀"] + "/" + 编码.url编码(名) + "/")

函数 后台_批量删除(请求, 参数):
    令 g = 后台_守卫(请求)
    如果 g != 空:
        返回 g
    令 名 = 参数["模型"]
    如果 非 后台_有模型(名):
        返回 未找到("没有这个模型")
    令 ids = 请求.取表单().获取("ids", "")
    如果 ids != "":
        遍历 id 在 ids.拆分(","):
            如果 id.去空白() != "":
                模型_删除ID(名, 整数(id))
    返回 重定向(后台_设置["前缀"] + "/" + 编码.url编码(名) + "/")

# CSV 单元格转义
函数 后台_CSV单元(s):
    如果 s.包含(",") 或 s.包含(字符(34)) 或 s.包含(字符(10)) 或 s.包含(字符(13)):
        返回 字符(34) + s.替换(字符(34), 字符(34) + 字符(34)) + 字符(34)
    返回 s

函数 后台_CSV(字段们, 记录们):
    令 行们 = []
    令 头 = []
    遍历 f 在 字段们:
        头.追加(后台_CSV单元(内建_文本(f)))
    行们.追加(内建_拼接(头, ","))
    遍历 记录 在 记录们:
        令 列 = []
        遍历 f 在 字段们:
            列.追加(后台_CSV单元(内建_文本(记录.获取(f, ""))))
        行们.追加(内建_拼接(列, ","))
    返回 内建_拼接(行们, 字符(10))

函数 后台_导出CSV(请求, 参数):
    令 g = 后台_守卫(请求)
    如果 g != 空:
        返回 g
    令 名 = 参数["模型"]
    如果 非 后台_有模型(名):
        返回 未找到("没有这个模型")
    令 定义 = 模型_取定义(名)
    令 记录们 = 模型_全部(名)
    令 csv = 字符(65279) + 后台_CSV(定义["字段们"], 记录们)
    返回 文件下载(csv, 名 + ".csv", "text/csv; charset=utf-8")

# ---- 数据处理：搜索 / 排序 / 关系 / 分页 ----
函数 后台_搜索(记录们, 关键词, 字段们):
    令 r = []
    遍历 记录 在 记录们:
        令 命中 = 假
        遍历 f 在 字段们:
            如果 文本(记录.获取(f, "")).包含(关键词):
                命中 = 真
                中断
        如果 命中:
            r.追加(记录)
    返回 r

函数 后台_排序(记录们, 字段, 倒序):
    令 对们 = []
    遍历 记录 在 记录们:
        对们.追加([记录.获取(字段, ""), 记录])
    令 排好 = 对们.排序按(函数(p): p[0])
    如果 倒序:
        排好 = 反转(排好)
    返回 排好.映射(函数(p): p[1])

函数 后台_分页切片(全部, 页, 每页):
    如果 页 < 1:
        页 = 1
    如果 每页 < 1:
        每页 = 20
    令 总数 = 长度(全部)
    令 起 = (页 - 1) * 每页
    令 止 = 起 + 每页
    如果 止 > 总数:
        止 = 总数
    令 记录们 = []
    如果 起 < 总数:
        记录们 = 全部[起:止]
    令 总页 = (总数 + 每页 - 1) // 每页
    如果 总页 < 1:
        总页 = 1
    返回 {
        "总数": 总数, "页": 页, "每页": 每页, "总页数": 总页,
        "记录们": 记录们,
        "有上一页": 页 > 1, "有下一页": 页 < 总页,
        "上一页": 页 - 1, "下一页": 页 + 1
    }

# 关系配置：{ 字段: [从模型, 显示字段] }；预建 {从模型: {id: 记录}} 缓存
函数 后台_建关系缓存(关系):
    令 缓存 = {}
    遍历 字段 在 关系.键():
        令 定义 = 关系[字段]
        令 从名 = 定义[0]
        如果 非 缓存.包含(从名):
            令 idx = {}
            遍历 子 在 模型_全部(从名):
                idx[文本(子["id"])] = 子
            缓存[从名] = idx
    返回 缓存

函数 后台_关系显示(关系, 从缓存, 字段, 值):
    如果 关系.包含(字段):
        令 定义 = 关系[字段]
        令 从名 = 定义[0]
        令 显示字段 = 定义[1]
        令 idx = 从缓存.获取(从名, {})
        令 子 = idx.获取(文本(值), 空)
        如果 子 != 空:
            返回 文本(子.获取(显示字段, ""))
        返回 "（无）"
    返回 文本(值)

# ---- HTML 构件 ----
函数 后台_排序链接(名, 字段, 排序, 倒序, 关键词):
    令 前缀 = 后台_设置["前缀"]
    令 基 = 前缀 + "/" + 编码.url编码(名) + "/"
    令 新倒 = "0"
    如果 排序 == 字段 与 非 倒序:
        新倒 = "1"
    令 箭头 = ""
    如果 排序 == 字段:
        如果 倒序:
            箭头 = " ↓"
        否则:
            箭头 = " ↑"
    令 参 = ""
    如果 关键词 != "":
        参 = "&关键词=" + 编码.url编码(关键词)
    返回 "<a href=\"" + 基 + "?排序=" + 编码.url编码(字段) + "&倒序=" + 新倒 + 参 + "\">" + 内建_转义(字段) + 箭头 + "</a>"

函数 后台_搜索框(名, 关键词, 排序, 倒序):
    令 前缀 = 后台_设置["前缀"]
    令 基 = 前缀 + "/" + 编码.url编码(名) + "/"
    令 h = ["<form method=\"get\" action=\"" + 基 + "\" class=\"搜索条\">"]
    令 排序隐藏 = ""
    如果 排序 != "":
        令 d = "0"
        如果 倒序:
            d = "1"
        排序隐藏 = "<input type=\"hidden\" name=\"排序\" value=\"" + 内建_转义(排序) + "\"><input type=\"hidden\" name=\"倒序\" value=\"" + d + "\">"
    h.追加(排序隐藏 + "<input name=\"关键词\" value=\"" + 内建_转义(关键词) + "\" placeholder=\"搜索…\">")
    h.追加("<button type=\"submit\">搜索</button>")
    如果 关键词 != "":
        h.追加("<a class=\"弱\" href=\"" + 基 + "\">清除</a>")
    h.追加("</form>")
    返回 内建_拼接(h, "")

函数 后台_批量脚本():
    令 s = "<script>"
    s = s + "function 全选(cb){var cs=document.querySelectorAll('input[name=id]');for(var i=0;i<cs.length;i++){cs[i].checked=cb.checked;}}"
    s = s + "function 批量删除(btn){var url=btn.getAttribute('data-url');var ids=[];var cs=document.querySelectorAll('input[name=id]:checked');for(var i=0;i<cs.length;i++){ids.push(cs[i].value);}if(ids.length==0){alert('请先勾选要删除的行');return;}if(!confirm('确定删除选中的 '+ids.length+' 条？')){return;}var f=document.createElement('form');f.method='post';f.action=url;var h=document.createElement('input');h.type='hidden';h.name='ids';h.value=ids.join(',');f.appendChild(h);document.body.appendChild(f);f.submit();}"
    s = s + "</script>"
    返回 s

函数 后台_表格(名, 定义, 记录们, 关系, 从缓存, 排序, 倒序, 关键词):
    令 前缀 = 后台_设置["前缀"]
    令 字段们 = 定义["字段们"]
    令 基础 = 前缀 + "/" + 编码.url编码(名) + "/"
    令 h = ["<table class=\"表格\"><thead><tr><th class=\"勾选列\"><input type=\"checkbox\" onclick=\"全选(this)\" title=\"全选\"></th><th>id</th>"]
    遍历 f 在 字段们:
        h.追加("<th>" + 后台_排序链接(名, f, 排序, 倒序, 关键词) + "</th>")
    h.追加("<th>操作</th></tr></thead><tbody>")
    如果 长度(记录们) == 0:
        h.追加("<tr><td colspan=\"" + 文本(长度(字段们) + 3) + "\" class=\"弱\">（没有记录）</td></tr>")
    遍历 记录 在 记录们:
        h.追加("<tr><td class=\"勾选列\"><input type=\"checkbox\" name=\"id\" value=\"" + 文本(记录["id"]) + "\"></td>")
        h.追加("<td>" + 文本(记录["id"]) + "</td>")
        遍历 f 在 字段们:
            令 显示 = 后台_关系显示(关系, 从缓存, f, 记录.获取(f, ""))
            h.追加("<td>" + 内建_转义(显示) + "</td>")
        h.追加("<td class=\"操作\"><a href=\"" + 基础 + 文本(记录["id"]) + "\">编辑</a> ")
        h.追加("<form method=\"post\" action=\"" + 基础 + 文本(记录["id"]) + "/删除\" style=\"display:inline\" onsubmit=\"return confirm('确定删除？')\"><button type=\"submit\" class=\"链接按钮\">删除</button></form></td></tr>")
    h.追加("</tbody></table>")
    返回 内建_拼接(h, "")

函数 后台_分页html(名, 分页, 关键词, 排序, 倒序):
    如果 分页["总页数"] <= 1:
        返回 ""
    令 前缀 = 后台_设置["前缀"]
    令 基 = 前缀 + "/" + 编码.url编码(名) + "/"
    令 参 = ""
    如果 关键词 != "":
        参 = 参 + "&关键词=" + 编码.url编码(关键词)
    如果 排序 != "":
        令 d = "0"
        如果 倒序:
            d = "1"
        参 = 参 + "&排序=" + 编码.url编码(排序) + "&倒序=" + d
    令 h = ["<div class=\"分页\">"]
    如果 分页["有上一页"]:
        h.追加("<a href=\"" + 基 + "?页=" + 文本(分页["上一页"]) + 参 + "\">上一页</a>")
    否则:
        h.追加("<span class=\"弱\">上一页</span>")
    h.追加(" 第 " + 文本(分页["页"]) + " / " + 文本(分页["总页数"]) + " 页（共 " + 文本(分页["总数"]) + " 条） ")
    如果 分页["有下一页"]:
        h.追加("<a href=\"" + 基 + "?页=" + 文本(分页["下一页"]) + 参 + "\">下一页</a>")
    否则:
        h.追加("<span class=\"弱\">下一页</span>")
    h.追加("</div>")
    返回 内建_拼接(h, "")

函数 后台_下拉(关系, 从缓存, 字段, 当前值):
    令 定义 = 关系[字段]
    令 从名 = 定义[0]
    令 显示字段 = 定义[1]
    令 idx = 从缓存.获取(从名, {})
    令 当前 = 内建_文本(当前值)
    令 h = ["<option value=\"\">（不选）</option>"]
    遍历 id 在 idx.键():
        令 记录 = idx[id]
        令 显示 = 内建_转义(内建_文本(记录.获取(显示字段, "")))
        令 sel = ""
        如果 内建_文本(id) == 当前:
            sel = " selected"
        h.追加("<option value=\"" + 内建_转义(id) + "\"" + sel + ">" + 显示 + "</option>")
    返回 内建_拼接(h, "")

# 规整：关系字段若是数字文本，转成整数（与外键 int 一致）
函数 后台_规整(名, 记录):
    令 关系 = 后台_设置["关系"].获取(名, {})
    遍历 字段 在 关系.键():
        令 v = 记录.获取(字段, "")
        如果 内建_文本(v) != "":
            尝试:
                记录[字段] = 整数(v)
            捕获 异常 为 e:
                令 _ = e
    返回 记录

函数 后台_表单html(定义, 记录, 提交到, 按钮, 关系 = 空, 从缓存 = 空):
    令 字段们 = 定义["字段们"]
    如果 记录 == 空:
        记录 = {}
    如果 关系 == 空:
        关系 = {}
    如果 从缓存 == 空:
        从缓存 = {}
    令 h = ["<form method=\"post\" action=\"" + 提交到 + "\" class=\"后台表单\">"]
    遍历 f 在 字段们:
        如果 关系.包含(f):
            h.追加("<div class=\"字段\"><label>" + 内建_转义(f) + "</label><select name=\"" + 内建_转义(f) + "\">" + 后台_下拉(关系, 从缓存, f, 记录.获取(f, "")) + "</select></div>")
        否则:
            令 v = 内建_文本(记录.获取(f, ""))
            h.追加("<div class=\"字段\"><label>" + 内建_转义(f) + "</label><input name=\"" + 内建_转义(f) + "\" value=\"" + 内建_转义(v) + "\"></div>")
    h.追加("<button type=\"submit\">" + 内建_转义(按钮) + "</button></form>")
    返回 内建_拼接(h, "")

函数 后台_页面(标题, 内容):
    令 前缀 = 后台_设置["前缀"]
    令 h = []
    h.追加("<!DOCTYPE html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">")
    h.追加("<title>" + 内建_转义(标题) + " · " + 内建_转义(后台_设置["标题"]) + "</title>")
    h.追加("<style>" + 后台_样式() + "</style></head><body>")
    h.追加("<header><a class=\"品牌\" href=\"" + 前缀 + "/\">" + 内建_转义(后台_设置["标题"]) + "</a>")
    h.追加("<nav><a href=\"" + 前缀 + "/\">模型</a><a href=\"" + 前缀 + "/图片\">图片</a><a href=\"" + 前缀 + "/登出\">登出</a></nav></header>")
    h.追加("<main><h1>" + 内建_转义(标题) + "</h1>" + 内容 + "</main></body></html>")
    返回 内建_拼接(h, 字符(10))

函数 后台_样式():
    返回 ":root{--主:#2563eb;--字:#1f2328;--弱:#6b7280;--线:#e5e7eb;--底:#f7f8fa}*{box-sizing:border-box}body{margin:0;font:15px/1.6 system-ui,-apple-system,'Segoe UI','Noto Sans SC',sans-serif;color:var(--字);background:var(--底)}header{display:flex;align-items:center;justify-content:space-between;padding:.9rem 1.4rem;background:#fff;border-bottom:1px solid var(--线)}.品牌{font-size:1.1rem;font-weight:700;color:var(--字);text-decoration:none}nav a{margin-left:1rem;color:var(--主);text-decoration:none}main{max-width:64rem;margin:0 auto;padding:1.4rem}h1{font-size:1.3rem;margin:0 0 1rem}a{color:var(--主)}.弱{color:var(--弱)}.按钮{display:inline-block;padding:.5rem 1rem;background:var(--主);color:#fff;border-radius:.375rem;text-decoration:none}.表格{width:100%;border-collapse:collapse;background:#fff;border:1px solid var(--线);border-radius:.5rem;overflow:hidden}.表格 th,.表格 td{padding:.55rem .7rem;border-bottom:1px solid var(--线);text-align:left;font-size:.92rem}.表格 th{background:#f9fafb;color:var(--弱)}.表格 tr:last-child td{border-bottom:0}.操作{white-space:nowrap}.链接按钮{border:0;background:none;color:#dc2626;cursor:pointer;font:inherit;padding:0}.分页{margin-top:1rem;display:flex;gap:1rem;align-items:center}.后台表单{max-width:36rem}.字段{margin-bottom:.9rem}.字段 label{display:block;color:var(--弱);font-size:.85rem;margin-bottom:.3rem}.字段 input{width:100%;padding:.55rem .7rem;border:1px solid var(--线);border-radius:.375rem;font:inherit}button{padding:.5rem 1.1rem;border:0;border-radius:.375rem;background:var(--主);color:#fff;font:inherit;cursor:pointer}.错误{padding:.6rem .9rem;background:#fef2f2;color:#dc2626;border-radius:.375rem;margin-bottom:1rem}.模型列表{list-style:none;padding:0}.模型列表 li{padding:.8rem 1rem;background:#fff;border:1px solid var(--线);border-radius:.5rem;margin-bottom:.6rem;display:flex;justify-content:space-between}.工具条{display:flex;gap:.5rem;margin:1rem 0;align-items:center}.按钮.次{background:#6b7280}.按钮.危险{background:#dc2626}.勾选列{width:2.2rem;text-align:center}.图片网格{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:1rem}.图片卡{background:#fff;border:1px solid var(--线);border-radius:.5rem;padding:.6rem}.图片卡 img{width:100%;height:120px;object-fit:cover;border-radius:.375rem;background:#f9fafb}.图片名{font-size:.85rem;color:var(--弱);margin:.4rem 0;word-break:break-all}"