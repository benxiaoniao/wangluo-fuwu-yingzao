# 会话 —— Cookie 会话号 + 服务端内存存储（开发用；生产可换 Redis/DB）
# 顶层名字统一 会话_ 前缀。

导入 标识

会话_存储 = {}

函数 会话_Cookie字典(请求):
    令 raw = 请求.头("cookie", "")
    令 d = {}
    如果 raw != "":
        遍历 段 在 raw.拆分(";"):
            令 kv = 段.拆分("=")
            如果 长度(kv) >= 2:
                d[kv[0].去空白()] = kv[1].去空白()
            否则如果 长度(kv) == 1 与 kv[0].去空白() != "":
                d[kv[0].去空白()] = ""
    返回 d

# 读会话：返回 {"sid", "数据", "新"}
函数 会话_读(请求):
    令 cookies = 会话_Cookie字典(请求)
    令 sid = cookies.获取("sessionid", "")
    如果 sid != "" 与 会话_存储.包含(sid):
        返回 {"sid": sid, "数据": 会话_存储[sid], "新": 假}
    令 新sid = 标识.唯一标识短()
    会话_存储[新sid] = {}
    返回 {"sid": 新sid, "数据": 会话_存储[新sid], "新": 真}

# 写回会话：存数据 + 设 cookie
函数 会话_写(响应, s):
    会话_存储[s["sid"]] = s["数据"]
    响应.设cookie("sessionid", s["sid"], {"路径": "/", "仅HTTP": 真, "同站": "Lax"})

# 现成的会话中间件（前置载入、后置保存）
函数 会话_前置(请求):
    令 s = 会话_读(请求)
    请求.原始["_会话信息"] = s
    请求.会话 = s["数据"]
    返回 空

函数 会话_后置(请求, 响应):
    令 s = 请求.原始.获取("_会话信息", 空)
    如果 s != 空:
        会话_写(响应, s)
    返回 响应

函数 会话_中间件():
    返回 {"前置": 会话_前置, "后置": 会话_后置}

# ---- 一次性提示（flash）：存进会话，取一次即清 ----
函数 会话_设提示(请求, 级别, 文本):
    如果 请求.会话 != 空:
        令 列表 = 请求.会话.获取("_提示们", [])
        列表.追加({"级别": 级别, "文本": 文本})
        请求.会话["_提示们"] = 列表

函数 会话_取提示(请求):
    如果 请求.会话 == 空:
        返回 []
    令 列表 = 请求.会话.获取("_提示们", [])
    请求.会话["_提示们"] = []
    返回 列表

# 把提示渲染成 HTML（配合 样式.css 里的 .提示 系列）
函数 提示_渲染(提示们):
    令 段 = []
    遍历 t 在 提示们:
        令 级别 = 内建_文本(t["级别"])
        段.追加("<div class=\"提示 提示-" + 内建_转义(级别) + "\">" + 内建_转义(t["文本"]) + "</div>")
    返回 内建_拼接(段, "")