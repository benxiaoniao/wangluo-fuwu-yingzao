# 响应 —— HTTP 响应对象与常用快捷响应
# 文本正文：响应对象自己拼原始 HTTP 响应文本（支持多个 Set-Cookie、非 ASCII 头），不依赖 构造响应。
# 字节正文（0.3.6 起）：走 HTTP服务端.构造响应 的字节通道（头值须 ASCII，W18 未修；
#   处理函数直接返回裸字节会断连，所以必须借 构造响应 包装）。
# 顶层名字：类 响应对象；函数 响应 / 字节响应 / 重定向 / JSON响应 / 文本响应 / 未找到 / 错误响应。

导入 json
导入 编码
导入 文件
导入 路径
导入 文本 为 文本库
导入 HTTP服务端

# 通用响应对象
类 响应对象:
    函数 初始化(自身, 内容 = "", 状态 = 200, 内容类型 = "text/html; charset=utf-8", 头 = 空):
        自身.内容 = 内容
        自身.状态 = 状态
        自身.内容类型 = 内容类型
        自身.头 = {}
        如果 头 != 空:
            自身.头.更新(头)
        自身.cookie们 = []

    # 设一个响应头
    函数 设头(自身, 键, 值):
        自身.头[键] = 值
        返回 自身

    # 追加一个 Set-Cookie。选项（字典，均可选）：
    #   路径 / 域 / 最大age(秒) / 仅HTTP(真) / 仅安全(真) / 同站(文本)
    函数 设cookie(自身, 键, 值, 选项 = 空):
        令 c = 键 + "=" + 值
        如果 选项 != 空:
            如果 选项.包含("路径"):
                c = c + "; Path=" + 选项["路径"]
            如果 选项.包含("域"):
                c = c + "; Domain=" + 选项["域"]
            如果 选项.包含("最大age"):
                c = c + "; Max-Age=" + 内建_文本(选项["最大age"])
            如果 选项.包含("同站"):
                c = c + "; SameSite=" + 选项["同站"]
            如果 选项.包含("仅HTTP") 与 选项["仅HTTP"]:
                c = c + "; HttpOnly"
            如果 选项.包含("仅安全") 与 选项["仅安全"]:
                c = c + "; Secure"
        自身.cookie们.追加("Set-Cookie: " + c)
        返回 自身

    # 删 cookie（Max-Age=0）
    函数 删cookie(自身, 键, 选项 = 空):
        如果 选项 == 空:
            选项 = {"路径": "/"}
        令 合并 = 选项合并(选项, {"最大age": 0})
        返回 自身.设cookie(键, "", 合并)

    # 拼出完整的 HTTP 响应：正文是字节时走 构造响应 的字节通道，否则自拼文本
    函数 输出(自身):
        如果 类型(自身.内容) == "字节":
            返回 自身.输出字节()
        令 正文 = 内建_文本(自身.内容)
        令 行们 = []
        行们.追加("HTTP/1.1 " + 内建_文本(自身.状态) + " " + 内建_状态原因(自身.状态))
        行们.追加("Content-Type: " + 自身.内容类型)
        遍历 k 在 自身.头.键():
            行们.追加(k + ": " + 内建_文本(自身.头[k]))
        遍历 c 在 自身.cookie们:
            行们.追加(c)
        行们.追加("Content-Length: " + 内建_文本(内建_字节数(正文)))
        行们.追加("Connection: close")
        返回 内建_拼行(行们) + 字符(13) + 字符(10) + 字符(13) + 字符(10) + 正文

    # 字节正文：交给 构造响应（状态 + 字节 + 类型 + 头对列表），字节原样到客户端
    # 注意：头名字与值只能是 ASCII（W18 仍在），非 ASCII 头请用文本正文 + 自拼路径
    函数 输出字节(自身):
        令 对们 = []
        遍历 k 在 自身.头.键():
            对们.追加([k, 内建_文本(自身.头[k])])
        遍历 c 在 自身.cookie们:
            对们.追加(["Set-Cookie", 文本库.去前缀(c, "Set-Cookie: ")])
        返回 HTTP服务端.构造响应(自身.状态, 自身.内容, 自身.内容类型, 对们)

# 合并两个字典（浅合并），返回新字典
函数 选项合并(甲, 乙):
    令 r = {}
    r.更新(甲)
    r.更新(乙)
    返回 r

# ---- 快捷构造 ----

# 造一个响应（最常用）
函数 响应(内容 = "", 状态 = 200, 内容类型 = "text/html; charset=utf-8", 头 = 空):
    返回 新建 响应对象(内容, 状态, 内容类型, 头)

# 字节响应：正文是原始字节（0.3.6 起支持二进制出口），输出时走 构造响应 的字节通道
函数 字节响应(字节, 内容类型 = "application/octet-stream", 状态 = 200):
    返回 新建 响应对象(字节, 状态, 内容类型)

# 按文件造响应（内联伺服，自动 ETag/304）：命中 If-None-Match 回 304，
# 否则字节读入直出并带 ETag + Cache-Control: no-cache（开发服务器语义：每次协商缓存）
函数 文件响应(文件路径, 内容类型, 请求):
    令 etag = "\"" + 内建_文本(路径.大小(文件路径)) + "-" + 路径.修改时间(文件路径) + "\""
    令 客户etag = 请求.头("if-none-match", "")
    如果 客户etag != "" 与 客户etag == etag:
        返回 响应("", 304).设头("ETag", etag).设头("Cache-Control", "no-cache")
    返回 字节响应(文件.读字节(文件路径), 内容类型).设头("ETag", etag).设头("Cache-Control", "no-cache")

# 重定向
函数 重定向(地址, 状态 = 302):
    令 r = 新建 响应对象("", 状态, "text/html; charset=utf-8")
    r.设头("Location", 地址)
    返回 r

# JSON 响应
函数 JSON响应(数据, 状态 = 200, 头 = 空):
    令 r = 新建 响应对象(json.转文本(数据), 状态, "application/json; charset=utf-8", 头)
    返回 r

# 纯文本响应
函数 文本响应(内容, 状态 = 200, 内容类型 = "text/plain; charset=utf-8"):
    返回 新建 响应对象(内容, 状态, 内容类型)

# 404
函数 未找到(消息 = "页面不存在"):
    令 页 = "<!DOCTYPE html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><title>404</title></head><body><h1>404</h1><p>" + 内建_转义(消息) + "</p></body></html>"
    返回 新建 响应对象(页, 404)

# 错误响应
函数 错误响应(状态, 消息):
    令 页 = "<!DOCTYPE html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><title>" + 内建_文本(状态) + "</title></head><body><h1>" + 内建_文本(状态) + " " + 内建_状态原因(状态) + "</h1><p>" + 内建_转义(消息) + "</p></body></html>"
    返回 新建 响应对象(页, 状态)

# 204 无内容
函数 无内容():
    返回 新建 响应对象("", 204)

# 401 未授权
函数 未授权(消息 = "需要登录"):
    返回 错误响应(401, 消息)

# 403 禁止访问
函数 禁止(消息 = "禁止访问"):
    返回 错误响应(403, 消息)

# 301 永久重定向
函数 永久重定向(地址):
    返回 重定向(地址, 301)

# 405 方法不允许（带 Allow 头）
函数 方法不允许(允许们):
    令 r = 错误响应(405, "方法不允许")
    r.设头("Allow", 内建_拼接(允许们, ", "))
    返回 r

# 文件下载（把内容作为附件返回；文本正文用 filename + filename* 兼容中文，
# 字节正文只能给 ASCII 头（W18），所以只发 filename*（RFC 5987，各浏览器都认））
函数 文件下载(内容, 文件名, 内容类型 = "application/octet-stream"):
    令 r = 新建 响应对象(内容, 200, 内容类型)
    令 编码名 = 编码.url编码(文件名)
    如果 类型(内容) == "字节":
        r.设头("Content-Disposition", "attachment; filename*=UTF-8''" + 编码名)
    否则:
        r.设头("Content-Disposition", "attachment; filename=\"" + 文件名 + "\"; filename*=UTF-8''" + 编码名)
    返回 r

# 文件下载：直接读磁盘文件（字节读入，文本/二进制都能下）
函数 下载文件(文件路径, 下载名 = 空):
    令 名 = 下载名
    如果 名 == 空:
        名 = 路径.文件名(文件路径)
    返回 文件下载(文件.读字节(文件路径), 名)