# 模板 —— 轻量模板引擎（Django 风格子集）
# 支持：{{ 变量 | 过滤器:参数 }}、{% 如果 %}…{% 否则如果 %}…{% 否则 %}…{% 结束如果 %}、
#       {% 遍历 x 在 列表 %}…{% 空 %}…{% 结束遍历 %}、{% 块 名 %}…{% 结束块 %}、
#       {% 继承 "父.html" %}、{% 包含 "子.html" %}、{# 注释 #}。
# 变量默认 HTML 自动转义，用 |安全 关闭。模板文件相对 模板设置["目录"]。
# 顶层名字统一 模板_ 前缀；对外：模板_设目录 / 模板_渲染 / 模板_渲染文件。

导入 文件
导入 路径
导入 数学
导入 文本 为 文本库

令 模板设置 = {"目录": "模板"}

函数 模板_设目录(目录):
    模板设置["目录"] = 目录

函数 模板_读模板(名):
    令 全 = 路径.连接(模板设置["目录"], 名)
    如果 非 文件.文件存在(全):
        抛出 文件错误("找不到模板「" + 名 + "」，找的是「" + 全 + "」")
    返回 文件.读文本(全)

# ---- 词法：切成 文本 / 变量 / 标签 / 注释 令牌 ----
函数 模板_词法(s):
    令 令牌们 = []
    令 i = 0
    令 n = 长度(s)
    令 缓冲 = ""
    当 i < n:
        令 c = s[i]
        令 已处理 = 假
        如果 c == "{" 与 i + 1 < n:
            令 c2 = s[i + 1]
            如果 c2 == "{" 或 c2 == "%" 或 c2 == "#":
                如果 缓冲 != "":
                    令牌们.追加({"类型": "文本", "内容": 缓冲})
                    缓冲 = ""
                如果 c2 == "{":
                    令 尾 = "}}"
                    令 类型 = "变量"
                否则如果 c2 == "%":
                    令 尾 = "%}"
                    令 类型 = "标签"
                否则:
                    令 尾 = "#}"
                    令 类型 = "注释"
                令 rest = s[i + 2:n]
                令 off = rest.查找(尾)
                如果 off == -1:
                    抛出 值错误("模板里的 { 没有配对的闭合（缺 " + 尾 + "）")
                令牌们.追加({"类型": 类型, "内容": rest[0:off]})
                i = i + 2 + off + 2
                已处理 = 真
        如果 非 已处理:
            缓冲 = 缓冲 + c
            i += 1
    如果 缓冲 != "":
        令牌们.追加({"类型": "文本", "内容": 缓冲})
    返回 令牌们

# ---- 解析：令牌 → 节点树 ----
函数 模板_首词(内容):
    令 段 = 内容.拆分(" ")
    返回 段[0]

函数 模板_取参数(内容):
    令 段 = 内容.拆分(" ")
    如果 长度(段) <= 1:
        返回 ""
    令 r = 段[1]
    遍历 k 在 范围(2, 长度(段)):
        r = r + " " + 段[k]
    返回 r.去空白()

函数 模板_取字符串(s):
    令 s = s.去空白()
    如果 长度(s) >= 2:
        令 a = s[0]
        令 b = s[长度(s) - 1]
        如果 (a == 字符(34) 与 b == 字符(34)) 或 (a == 字符(39) 与 b == 字符(39)) 或 (a == "「" 与 b == "」"):
            返回 s[1:长度(s) - 1]
    返回 s

函数 模板_解析节点们(令牌们, 状态, 停止们):
    令 节点们 = []
    当 状态["位置"] < 长度(令牌们):
        令 tok = 令牌们[状态["位置"]]
        令 类型 = tok["类型"]
        如果 类型 == "文本":
            节点们.追加({"类型": "文本", "值": tok["内容"]})
            状态["位置"] += 1
        否则如果 类型 == "注释":
            状态["位置"] += 1
        否则如果 类型 == "变量":
            节点们.追加({"类型": "变量", "表达式": tok["内容"].去空白()})
            状态["位置"] += 1
        否则:
            令 内容 = tok["内容"].去空白()
            令 词 = 模板_首词(内容)
            如果 词 在 停止们:
                返回 节点们
            状态["位置"] += 1
            如果 词 == "如果":
                节点们.追加(模板_解析如果(令牌们, 状态, 内容))
            否则如果 词 == "遍历":
                节点们.追加(模板_解析遍历(令牌们, 状态, 内容))
            否则如果 词 == "块":
                节点们.追加(模板_解析块(令牌们, 状态, 内容))
            否则如果 词 == "包含":
                节点们.追加({"类型": "包含", "模板": 模板_取字符串(模板_取参数(内容))})
            否则如果 词 == "继承":
                节点们.追加({"类型": "继承", "父": 模板_取字符串(模板_取参数(内容))})
            否则如果 词 == "空":
                节点们.追加({"类型": "空"})
            否则如果 词 == "注释":
                模板_解析节点们(令牌们, 状态, ["结束注释"])
                如果 状态["位置"] < 长度(令牌们):
                    状态["位置"] += 1
            否则:
                节点们.追加({"类型": "空"})
    返回 节点们

函数 模板_解析如果(令牌们, 状态, 首行):
    令 分支们 = []
    令 条件 = 模板_取参数(首行)
    令 节点们 = 模板_解析节点们(令牌们, 状态, ["否则", "否则如果", "结束如果"])
    分支们.追加({"条件": 条件, "节点们": 节点们})
    当 状态["位置"] < 长度(令牌们):
        令 tok = 令牌们[状态["位置"]]
        令 内容 = tok["内容"].去空白()
        令 词 = 模板_首词(内容)
        如果 词 == "结束如果":
            状态["位置"] += 1
            中断
        否则如果 词 == "否则如果":
            状态["位置"] += 1
            令 节点们2 = 模板_解析节点们(令牌们, 状态, ["否则", "否则如果", "结束如果"])
            分支们.追加({"条件": 模板_取参数(内容), "节点们": 节点们2})
        否则如果 词 == "否则":
            状态["位置"] += 1
            令 节点们3 = 模板_解析节点们(令牌们, 状态, ["结束如果"])
            分支们.追加({"条件": 空, "节点们": 节点们3})
            如果 状态["位置"] < 长度(令牌们):
                状态["位置"] += 1
            中断
        否则:
            状态["位置"] += 1
    返回 {"类型": "如果", "分支们": 分支们}

函数 模板_解析遍历(令牌们, 状态, 首行):
    令 参数 = 模板_取参数(首行)
    令 三 = 文本库.切成三段(参数, "在")
    令 变量 = 三[0].去空白()
    令 可迭代 = 三[2].去空白()
    令 节点们 = 模板_解析节点们(令牌们, 状态, ["空", "结束遍历"])
    令 空节点们 = []
    如果 状态["位置"] < 长度(令牌们):
        令 tok = 令牌们[状态["位置"]]
        如果 模板_首词(tok["内容"].去空白()) == "空":
            状态["位置"] += 1
            空节点们 = 模板_解析节点们(令牌们, 状态, ["结束遍历"])
        如果 状态["位置"] < 长度(令牌们):
            状态["位置"] += 1
    返回 {"类型": "遍历", "变量": 变量, "可迭代": 可迭代, "节点们": 节点们, "空节点们": 空节点们}

函数 模板_解析块(令牌们, 状态, 首行):
    令 名 = 模板_取参数(首行)
    令 节点们 = 模板_解析节点们(令牌们, 状态, ["结束块"])
    如果 状态["位置"] < 长度(令牌们):
        状态["位置"] += 1
    返回 {"类型": "块", "名": 名, "节点们": 节点们}

# ---- 求值：变量 / 过滤 / 条件 ----
函数 模板_是序号(键):
    如果 键 == "":
        返回 假
    遍历 c 在 范围(长度(键)):
        令 o = 序数(键[c])
        如果 o < 48 或 o > 57:
            返回 假
    返回 真

函数 模板_索引(容器, 键):
    令 t = 类型(容器)
    如果 t == "字典":
        返回 容器.获取(键, "")
    如果 t == "列表":
        如果 模板_是序号(键):
            令 idx = 整数(键)
            如果 0 <= idx 与 idx < 长度(容器):
                返回 容器[idx]
        返回 ""
    返回 ""

函数 模板_取值(表达式, 上下文):
    令 e = 表达式.去空白()
    如果 e == "":
        返回 ""
    如果 e == "真":
        返回 真
    如果 e == "假":
        返回 假
    如果 e == "空":
        返回 ""
    如果 模板_是序号(e):
        返回 整数(e)
    令 段 = e.拆分(".")
    令 当前 = 上下文.获取(段[0].去空白(), 空)
    遍历 k 在 范围(1, 长度(段)):
        当前 = 模板_索引(当前, 段[k].去空白())
    返回 当前

函数 模板_应用过滤器(值, 说明):
    令 名 = 说明
    令 参数 = ""
    如果 说明.包含(":"):
        令 三 = 文本库.切成三段(说明, ":")
        名 = 三[0].去空白()
        参数 = 模板_取字符串(三[2])
    如果 名 == "长度":
        令 t = 类型(值)
        如果 t == "文本" 或 t == "列表" 或 t == "字典":
            返回 长度(值)
        返回 0
    如果 名 == "小写":
        返回 内建_文本(值).小写()
    如果 名 == "大写":
        返回 内建_文本(值).大写()
    如果 名 == "去空白":
        返回 内建_文本(值).去空白()
    如果 名 == "默认":
        如果 内建_是空(值):
            返回 参数
        返回 值
    如果 名 == "连接":
        如果 类型(值) == "列表":
            返回 内建_拼接(值, 参数)
        返回 内建_文本(值)
    如果 名 == "上限":
        令 s = 内建_文本(值)
        令 宽 = 整数(参数)
        如果 长度(s) > 宽:
            返回 s[0:宽] + "…"
        返回 s
    如果 名 == "整数":
        返回 整数(值)
    如果 名 == "小数":
        返回 小数(值)
    如果 名 == "首项":
        如果 类型(值) == "列表" 与 长度(值) > 0:
            返回 值[0]
        返回 ""
    如果 名 == "末项":
        如果 类型(值) == "列表" 与 长度(值) > 0:
            返回 值[长度(值) - 1]
        返回 ""
    如果 名 == "计数":
        令 t = 类型(值)
        如果 t == "列表" 或 t == "字典" 或 t == "文本":
            返回 长度(值)
        返回 0
    如果 名 == "四舍五入":
        返回 数学.四舍五入(小数(值), 整数(参数))
    如果 名 == "替换":
        令 三 = 文本库.切成三段(参数, ":")
        如果 长度(三) == 3:
            返回 内建_文本(值).替换(三[0], 三[2])
        返回 内建_文本(值)
    返回 值

函数 模板_计算(表达式, 上下文):
    令 段 = 表达式.拆分("|")
    令 值 = 模板_取值(段[0].去空白(), 上下文)
    遍历 k 在 范围(1, 长度(段)):
        令 f = 段[k].去空白()
        如果 f != "安全":
            值 = 模板_应用过滤器(值, f)
    返回 值

函数 模板_求值(表达式, 上下文):
    令 段 = 表达式.拆分("|")
    令 值 = 模板_计算(表达式, 上下文)
    令 安全 = 假
    遍历 k 在 范围(1, 长度(段)):
        如果 段[k].去空白() == "安全":
            安全 = 真
    如果 非 安全:
        值 = 内建_转义(值)
    返回 内建_文本(值)

函数 模板_真值(值):
    令 t = 类型(值)
    如果 t == "布尔":
        返回 值
    如果 内建_是空(值):
        返回 假
    如果 (t == "整数" 或 t == "小数") 与 值 == 0:
        返回 假
    返回 真

# ---- 条件：支持 比较 / 与 或 非 / 成员 ----
函数 模板_求一侧(tok, 上下文):
    令 t = tok.去空白()
    如果 t == "真":
        返回 真
    如果 t == "假":
        返回 假
    如果 t == "空" 或 t == "None" 或 t == "none":
        返回 ""
    如果 模板_是序号(t):
        返回 整数(t)
    如果 长度(t) >= 2:
        令 a = t[0]
        令 b = t[长度(t) - 1]
        如果 (a == 字符(34) 与 b == 字符(34)) 或 (a == 字符(39) 与 b == 字符(39)):
            返回 模板_取字符串(t)
    返回 模板_计算(t, 上下文)

函数 模板_比较(运算符, 甲, 乙):
    如果 运算符 == "==":
        返回 甲 == 乙
    如果 运算符 == "!=":
        返回 甲 != 乙
    # 大小比较：0.3.4 起文本也能按码点比较；仅同类型才比，避免 数字<文本 报错
    令 ta = 类型(甲)
    令 tb = 类型(乙)
    令 都数 = (ta == "整数" 或 ta == "小数") 与 (tb == "整数" 或 tb == "小数")
    如果 ta == tb 或 都数:
        如果 运算符 == ">":
            返回 甲 > 乙
        如果 运算符 == "<":
            返回 甲 < 乙
        如果 运算符 == ">=":
            返回 甲 >= 乙
        如果 运算符 == "<=":
            返回 甲 <= 乙
    返回 假

函数 模板_比较原子(tok, 上下文):
    令 运算符们 = ["==", "!=", ">=", "<=", ">", "<"]
    令 命中 = 空
    令 位置 = -1
    遍历 op 在 运算符们:
        令 段 = tok.拆分(op)
        如果 长度(段) == 2:
            命中 = op
            位置 = 0
            中断
    如果 命中 == 空:
        返回 模板_真值(模板_求一侧(tok, 上下文))
    令 段 = tok.拆分(命中)
    令 甲 = 模板_求一侧(段[0], 上下文)
    令 乙 = 模板_求一侧(段[1], 上下文)
    返回 模板_比较(命中, 甲, 乙)

函数 模板_条件真(表达式, 上下文):
    令 tok = 表达式.去空白()
    如果 tok.开头是("非 "):
        返回 非 模板_条件真(tok[2:长度(tok)], 上下文)
    令 段 = tok.拆分(" 或 ")
    如果 长度(段) > 1:
        遍历 i 在 范围(长度(段)):
            如果 模板_条件真(段[i], 上下文):
                返回 真
        返回 假
    令 段2 = tok.拆分(" 与 ")
    如果 长度(段2) > 1:
        遍历 i 在 范围(长度(段2)):
            如果 非 模板_条件真(段2[i], 上下文):
                返回 假
        返回 真
    如果 tok.包含(" 在 "):
        令 三 = 文本库.切成三段(tok, " 在 ")
        令 成员 = 模板_求一侧(三[0], 上下文)
        令 容器 = 模板_求一侧(三[2], 上下文)
        如果 类型(容器) == "字典":
            返回 容器.包含(内建_文本(成员))
        如果 类型(容器) == "列表" 或 类型(容器) == "文本":
            返回 内建_文本(成员) 在 容器
        返回 假
    如果 tok.包含(" 不在 "):
        令 三 = 文本库.切成三段(tok, " 不在 ")
        令 成员 = 模板_求一侧(三[0], 上下文)
        令 容器 = 模板_求一侧(三[2], 上下文)
        如果 类型(容器) == "字典":
            返回 非 容器.包含(内建_文本(成员))
        如果 类型(容器) == "列表" 或 类型(容器) == "文本":
            返回 内建_文本(成员) 不在 容器
        返回 真
    返回 模板_比较原子(tok, 上下文)

# ---- 渲染 ----
函数 模板_渲染节点们(节点们, 上下文, 块覆盖):
    令 输出 = []
    遍历 节 在 节点们:
        令 种类 = 节["类型"]
        如果 种类 == "文本":
            输出.追加(节["值"])
        否则如果 种类 == "变量":
            输出.追加(模板_求值(节["表达式"], 上下文))
        否则如果 种类 == "如果":
            输出.追加(模板_渲染如果(节, 上下文, 块覆盖))
        否则如果 种类 == "遍历":
            输出.追加(模板_渲染遍历(节, 上下文, 块覆盖))
        否则如果 种类 == "块":
            如果 块覆盖.包含(节["名"]):
                输出.追加(模板_渲染节点们(块覆盖[节["名"]], 上下文, 块覆盖))
            否则:
                输出.追加(模板_渲染节点们(节["节点们"], 上下文, 块覆盖))
        否则如果 种类 == "包含":
            令 子文本 = 模板_读模板(节["模板"])
            输出.追加(模板_渲染_带块(子文本, 上下文, {}))
    返回 内建_拼接(输出, "")

函数 模板_渲染如果(节, 上下文, 块覆盖):
    遍历 分支 在 节["分支们"]:
        如果 分支["条件"] == 空:
            返回 模板_渲染节点们(分支["节点们"], 上下文, 块覆盖)
        如果 模板_条件真(分支["条件"], 上下文):
            返回 模板_渲染节点们(分支["节点们"], 上下文, 块覆盖)
    返回 ""

函数 模板_渲染遍历(节, 上下文, 块覆盖):
    令 可迭代 = 模板_计算(节["可迭代"], 上下文)
    令 t = 类型(可迭代)
    如果 t == "字典":
        可迭代 = 可迭代.值()
        t = "列表"
    如果 t != "列表":
        返回 模板_渲染节点们(节["空节点们"], 上下文, 块覆盖)
    如果 长度(可迭代) == 0:
        返回 模板_渲染节点们(节["空节点们"], 上下文, 块覆盖)
    令 变量 = 节["变量"]
    令 输出 = []
    遍历 项 在 可迭代:
        令 新上下文 = {}
        新上下文.更新(上下文)
        新上下文[变量] = 项
        输出.追加(模板_渲染节点们(节["节点们"], 新上下文, 块覆盖))
    返回 内建_拼接(输出, "")

# 带块覆盖的渲染（处理 继承/块）
函数 模板_渲染_带块(模板文本, 上下文, 块覆盖):
    令 令牌们 = 模板_词法(模板文本)
    令 状态 = {"位置": 0}
    令 节点们 = 模板_解析节点们(令牌们, 状态, [])
    遍历 节 在 节点们:
        如果 节["类型"] == "继承":
            令 子块 = {}
            子块.更新(块覆盖)
            遍历 节2 在 节点们:
                如果 节2["类型"] == "块":
                    子块[节2["名"]] = 节2["节点们"]
            令 父文本 = 模板_读模板(节["父"])
            返回 模板_渲染_带块(父文本, 上下文, 子块)
    返回 模板_渲染节点们(节点们, 上下文, 块覆盖)

# 对外：渲染一段模板文本
函数 模板_渲染(模板文本, 上下文):
    如果 上下文 == 空:
        上下文 = {}
    返回 模板_渲染_带块(模板文本, 上下文, {})

# 对外：渲染一个模板文件
函数 模板_渲染文件(名, 上下文):
    如果 上下文 == 空:
        上下文 = {}
    令 文本 = 模板_读模板(名)
    返回 模板_渲染(文本, 上下文)