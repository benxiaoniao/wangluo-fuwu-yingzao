# 上传 —— 解析 multipart/form-data 上传、保存文件
# 注意：基石 HTTP 层以 UTF-8 文本传输请求体（见 W5），所以：
#   - 文本类文件（txt/csv/json/代码…）可直接上传保存；
#   - 二进制文件（图片/压缩包…）请客户端先 base64，再用 上传_保存base64 落盘。
# 顶层名字统一 上传_ 前缀。

导入 文件
导入 路径
导入 标识
导入 编码
导入 json
导入 文本 为 文本库

# 图片索引（供后台图片管理用）：目录/索引.json 是一个列表，每项 {名, 预览, 路径}
函数 上传_读索引(目录):
    令 p = 路径.连接(目录, "索引.json")
    如果 文件.文件存在(p):
        尝试:
            返回 json.读文件(p)
        捕获 异常 为 e:
            返回 []
    返回 []

函数 上传_写索引(目录, 列表):
    文件.写文本(路径.连接(目录, "索引.json"), json.转文本(列表))

函数 上传_记索引(目录, 记录):
    令 列表 = 上传_读索引(目录)
    列表.追加(记录)
    上传_写索引(目录, 列表)

# 从 Content-Disposition 头里取某个属性（name / filename）
函数 上传_取属性(头文本, 属性):
    令 键 = "; " + 属性 + "="
    令 段 = 头文本.拆分(键)
    如果 长度(段) < 2:
        返回 ""
    令 v = 段[1].拆分(";")[0].去空白()
    如果 v.开头是(字符(34)):
        令 rest = v[1:长度(v)]
        令 off = rest.查找(字符(34))
        如果 off >= 0:
            返回 rest[0:off]
        返回 rest
    返回 v

# 解析上传：返回 {"字段们": {名:值}, "文件们": [{名,文件名,内容,类型}, …]}
函数 上传_解析(请求):
    令 结果 = {"字段们": {}, "文件们": []}
    令 ct = 请求.头("content-type", "")
    如果 非 ct.开头是("multipart/form-data"):
        返回 结果
    令 段 = ct.拆分("boundary=")
    如果 长度(段) < 2:
        返回 结果
    令 界 = 段[1].去空白()
    如果 界.开头是(字符(34)):
        界 = 界[1:长度(界) - 1]
    否则:
        界 = 界.拆分(";")[0].去空白()
    令 正文 = 请求.正文
    令 分隔 = "--" + 界
    令 块们 = 正文.拆分(分隔)
    遍历 块 在 块们:
        令 b = 块
        如果 b.开头是(字符(13) + 字符(10)):
            b = b[2:长度(b)]
        否则如果 b.开头是(字符(10)):
            b = b[1:长度(b)]
        如果 b.结尾是(字符(13) + 字符(10)):
            b = b[0:长度(b) - 2]
        否则如果 b.结尾是(字符(10)):
            b = b[0:长度(b) - 1]
        如果 b == "" 或 b == "--":
            继续
        令 三 = 文本库.切成三段(b, 字符(13) + 字符(10) + 字符(13) + 字符(10))
        如果 长度(三) < 3:
            继续
        令 头文本 = 三[0]
        令 内容 = 三[2]
        令 名 = 上传_取属性(头文本, "name")
        令 文件名 = 上传_取属性(头文本, "filename")
        如果 文件名 != "":
            令 类型 = ""
            遍历 行 在 头文本.拆分(字符(13) + 字符(10)):
                如果 行.小写().开头是("content-type:"):
                    类型 = 行[长度("content-type:"):长度(行)].去空白()
            结果["文件们"].追加({"名": 名, "文件名": 文件名, "内容": 内容, "类型": 类型})
        否则:
            结果["字段们"][名] = 内容
    返回 结果

# 保存一个文本上传文件；文件名由服务端随机生成（防路径穿越），返回落盘路径
函数 上传_保存(文件信息, 目录, 允许扩展们 = 空):
    令 名 = 内建_文本(文件信息["文件名"])
    令 扩展 = 路径.后缀(名).小写()
    如果 允许扩展们 != 空 与 非 允许扩展们.包含(扩展):
        抛出 值错误("不允许的文件类型：" + 扩展)
    令 安全名 = 标识.唯一标识短() + 扩展
    令 全 = 路径.连接(目录, 安全名)
    文件.写文本(全, 内建_文本(文件信息["内容"]))
    返回 全

# 保存 base64 编码的二进制（客户端先 base64），返回落盘路径
函数 上传_保存base64(数据, 目录):
    令 字节 = 编码.base64解码(数据)
    令 全 = 路径.连接(目录, 标识.唯一标识短() + ".bin")
    文件.写字节(全, 字节)
    返回 全

# 保存 dataURL（data:image/png;base64,xxxx）——图片预览走这条，返回 {路径,预览,类型}
函数 上传_保存dataurl(预览, 目录):
    令 三 = 文本库.切成三段(预览, ",")
    如果 长度(三) < 3:
        抛出 值错误("不是 dataURL")
    令 头 = 三[0]
    令 数据 = 三[2]
    令 类型 = 文本库.去前缀(头, "data:")
    类型 = 文本库.去后缀(类型, ";base64")
    令 扩展 = 上传_类型扩展(类型)
    令 字节 = 编码.base64解码(数据)
    令 全 = 路径.连接(目录, 标识.唯一标识短() + 扩展)
    文件.写字节(全, 字节)
    返回 {"路径": 全, "预览": 预览, "类型": 类型, "扩展": 扩展}

# 常见图片类型 → 扩展名
函数 上传_类型扩展(类型):
    如果 类型 == "image/png":
        返回 ".png"
    如果 类型 == "image/jpeg":
        返回 ".jpg"
    如果 类型 == "image/gif":
        返回 ".gif"
    如果 类型 == "image/webp":
        返回 ".webp"
    如果 类型 == "image/svg+xml":
        返回 ".svg"
    返回 ".bin"