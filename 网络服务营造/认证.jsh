# 认证 —— 口令哈希 + 登录/登出 + 当前用户（基于会话）
# 口令只用「加盐哈希」存（加密.口令摘要，PBKDF2），绝不存明文。
# 依赖：会话中间件（请求.会话 才有值）。

导入 加密
导入 标识
导入 编码

# 生成“盐$哈希”字符串（存库用）；盐可传（校验时不用传）
函数 认证_哈希(口令, 盐 = 空):
    如果 盐 == 空:
        盐 = 标识.唯一标识短()
    返回 盐 + "$" + 加密.口令摘要(口令, 盐)

# 校验明文口令是否匹配存储值
函数 认证_校验(口令, 存储):
    令 段 = 存储.拆分("$")
    如果 长度(段) != 2:
        返回 假
    返回 加密.口令摘要(口令, 段[0]) == 段[1]

# 登录：把用户（字典或名字）放进会话
函数 认证_登录(请求, 用户):
    如果 请求.会话 != 空:
        请求.会话["_用户"] = 用户

# 登出
函数 认证_登出(请求):
    如果 请求.会话 != 空:
        请求.会话["_用户"] = 空

# 当前用户（未登录返回 空）
函数 认证_当前用户(请求):
    如果 请求.会话 == 空:
        返回 空
    返回 请求.会话.获取("_用户", 空)

# 是否已登录
函数 认证_已登录(请求):
    如果 请求.会话 == 空:
        返回 假
    返回 请求.会话.获取("_用户", 空) != 空

# 登录守卫：未登录就返回登录页响应（视图里 `如果 未登录 就返回`）
函数 认证_需要登录(请求):
    返回 请求.会话 != 空 与 请求.会话.获取("_用户", 空) != 空

# 视图守卫：未登录 → 返回 302 到登录页（带回跳地址 ?后=…）；已登录 → 空
函数 认证_守卫(请求, 登录地址 = "/登录"):
    如果 非 认证_已登录(请求):
        返回 重定向(登录地址 + "?后=" + 编码.url编码(请求.路径))
    返回 空

# 当前用户的角色（用户是字典时取 角色 字段）
函数 认证_角色(请求):
    令 u = 认证_当前用户(请求)
    如果 类型(u) == "字典":
        返回 内建_文本(u.获取("角色", ""))
    返回 ""