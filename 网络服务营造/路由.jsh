# 路由 —— 类 路由表：路径参数、命名路由、反查（reverse）
# 支持 Django 风格转换器：<int:名> <str:名> <slug:名> <path:名> <uuid:名>，以及默认 <名>（=str）。
# 顶层名字：类 路由表；内部函数统一 路由_ 前缀。

导入 正则
导入 编码

# 正则转义一段“字面”文本
函数 路由_转义(字面):
    令 r = 字面
    遍历 c 在 [".", "^", "$", "*", "+", "?", "(", ")", "[", "]", "{", "}", "|"]:
        r = r.替换(c, "\\" + c)
    返回 r

# 解析参数声明："int:文章id" → ["文章id", "int"]；"文章id" → ["文章id", "str"]
函数 路由_解析参数(内容):
    如果 内容.包含(":"):
        令 段 = 内容.拆分(":")
        返回 [段[1], 段[0]]
    返回 [内容, "str"]

# 转换器 → 正则片段（各一个捕获组，顺序与参数名一致）
函数 路由_转换正则(转换):
    如果 转换 == "int":
        返回 "([0-9]+)"
    如果 转换 == "uuid":
        返回 "([0-9a-fA-F\\-]+)"
    如果 转换 == "path":
        返回 "(.+)"
    如果 转换 == "slug":
        返回 "([^/]+)"
    返回 "([^/]+)"

# 转换器 → 值转换
函数 路由_转换值(转换, 值):
    如果 转换 == "int":
        返回 整数(值)
    返回 值

# 把一条路由模式编译成正则与参数信息
函数 路由_编译(原路径):
    令 段们 = 原路径.拆分("<")
    令 正则 = "^" + 路由_转义(段们[0])
    令 参数名们 = []
    令 转换器们 = []
    遍历 k 在 范围(1, 长度(段们)):
        令 右 = 段们[k].拆分(">")
        如果 长度(右) < 2:
            抛出 值错误("路由里的 < 没有配对的 >：" + 原路径)
        令 内容 = 右[0]
        令 剩余 = 右[1]
        令 名转 = 路由_解析参数(内容)
        参数名们.追加(名转[0])
        转换器们.追加(名转[1])
        正则 = 正则 + 路由_转换正则(名转[1])
        正则 = 正则 + 路由_转义(剩余)
    正则 = 正则 + "$"
    返回 {"正则": 正则, "参数名们": 参数名们, "转换器们": 转换器们}

# 规范请求路径：补前导 /、去尾部 /（根除外）、URL 解码
函数 路由_规范路径(路径):
    令 p = 编码.url解码(路径)
    如果 p == "":
        p = "/"
    如果 非 p.开头是("/"):
        p = "/" + p
    如果 长度(p) > 1 与 p.结尾是("/"):
        p = p[0:长度(p) - 1]
    返回 p

# 反向填充：把 <conv:名> 换成参数值
函数 路由_填充(原路径, 参数):
    令 段们 = 原路径.拆分("<")
    令 r = 段们[0]
    遍历 k 在 范围(1, 长度(段们)):
        令 右 = 段们[k].拆分(">")
        令 名转 = 路由_解析参数(右[0])
        令 名 = 名转[0]
        如果 类型(参数) != "字典" 或 非 参数.包含(名):
            抛出 值错误("反转路由缺少参数：" + 名)
        r = r + 内建_文本(参数[名]) + 右[1]
    返回 r

类 路由表:
    函数 初始化(自身):
        自身.路由们 = []
        自身.命名 = {}

    # 加一条路由，可链式。方法们 例如 ["GET"] 或 ["GET", "POST"]；名字用于反查。
    函数 加(自身, 路径, 处理, 方法们 = 空, 名字 = ""):
        如果 方法们 == 空:
            方法们 = ["GET"]
        令 编译 = 路由_编译(路径)
        令 路 = {
            "原路径": 路径,
            "正则": 编译["正则"],
            "参数名们": 编译["参数名们"],
            "转换器们": 编译["转换器们"],
            "处理": 处理,
            "方法们": 方法们,
            "名字": 名字
        }
        自身.路由们.追加(路)
        如果 名字 != "":
            自身.命名[名字] = 路
        返回 自身

    # 解析请求：命中返回 {"处理": 函数, "参数": 字典}，否则 空
    函数 解析(自身, 方法, 路径):
        令 p = 路由_规范路径(路径)
        遍历 路 在 自身.路由们:
            如果 路["方法们"].包含("*") 或 路["方法们"].包含(方法):
                如果 正则.匹配(路["正则"], p):
                    令 组们 = 正则.分组(路["正则"], p)
                    令 参数 = {}
                    遍历 idx 在 范围(长度(路["参数名们"])):
                        令 名 = 路["参数名们"][idx]
                        令 值 = 组们[idx]
                        参数[名] = 路由_转换值(路["转换器们"][idx], 值)
                    返回 {"处理": 路["处理"], "参数": 参数}
        返回 空

    # 反查 URL
    函数 反转(自身, 名字, 参数 = 空):
        遍历 路 在 自身.路由们:
            如果 路["名字"] == 名字:
                返回 路由_填充(路["原路径"], 参数)
        抛出 值错误("没有这个命名的路由：" + 内建_文本(名字))

    # 某路径上“除了这个方法外还有哪些方法能接”（用于 405 + Allow 头）
    函数 其他方法(自身, 方法, 路径):
        令 p = 路由_规范路径(路径)
        令 允许 = []
        遍历 路 在 自身.路由们:
            如果 正则.匹配(路["正则"], p):
                遍历 m 在 路["方法们"]:
                    如果 m != "*" 与 非 允许.包含(m):
                        允许.追加(m)
        返回 允许

    # 路径是否存在（不论方法）
    函数 有路径(自身, 路径):
        令 p = 路由_规范路径(路径)
        遍历 路 在 自身.路由们:
            如果 正则.匹配(路["正则"], p):
                返回 真
        返回 假

    # 所有已注册的 “方法 路径”
    函数 路径们(自身):
        令 r = []
        遍历 路 在 自身.路由们:
            遍历 m 在 路["方法们"]:
                r.追加(m + " " + 路["原路径"])
        返回 r