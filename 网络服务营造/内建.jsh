# 内建 —— 各模块共用的小工具
# 命名统一 内建_ 前缀，避免与包内其它模块的同名顶层定义冲突（包内共享命名空间）。

导入 编码

# 用 CRLF 把若干行拼成一段文本
函数 内建_拼行(行们):
    令 s = ""
    遍历 i 在 范围(长度(行们)):
        如果 i > 0:
            s = s + 字符(13) + 字符(10)
        s = s + 内建_文本(行们[i])
    返回 s

# 一段文本的 UTF-8 字节数（HTTP Content-Length 用）
函数 内建_字节数(文本):
    返回 长度(编码.文本字节(文本))

# 把任意值稳妥地转成文本：空 → ""，其余用内建 文本()
函数 内建_文本(值):
    如果 值 == 空:
        返回 ""
    返回 文本(值)

# HTML 转义（& < > " ' 五个），用于模板变量与属性值
函数 内建_转义(值):
    令 s = 内建_文本(值)
    s = s.替换("&", "&amp;")
    s = s.替换("<", "&lt;")
    s = s.替换(">", "&gt;")
    s = s.替换(字符(34), "&quot;")
    s = s.替换(字符(39), "&#x27;")
    返回 s

# 判断“空”：空串、空列表、空字典、空 都算空
函数 内建_是空(值):
    令 t = 类型(值)
    如果 t == "空":
        返回 真
    如果 t == "文本" 与 值 == "":
        返回 真
    如果 t == "列表" 与 长度(值) == 0:
        返回 真
    如果 t == "字典" 与 长度(值) == 0:
        返回 真
    返回 假

# 从字典/列表安全取值，取不到给默认
函数 内建_取(容器, 键, 默认):
    令 t = 类型(容器)
    如果 t == "字典":
        返回 容器.获取(键, 默认)
    如果 t == "列表":
        尝试:
            返回 容器[键]
        捕获 异常 为 e:
            返回 默认
    返回 默认

# HTTP 状态码 → 原因短语
函数 内建_状态原因(状态):
    令 表 = {
        200: "OK", 201: "Created", 204: "No Content", 304: "Not Modified",
        301: "Moved Permanently", 302: "Found", 303: "See Other", 307: "Temporary Redirect", 308: "Permanent Redirect",
        400: "Bad Request", 401: "Unauthorized", 403: "Forbidden", 404: "Not Found",
        405: "Method Not Allowed", 409: "Conflict", 422: "Unprocessable Entity",
        429: "Too Many Requests",
        500: "Internal Server Error", 501: "Not Implemented", 503: "Service Unavailable"
    }
    返回 表.获取(状态, "OK")

# 把列表用分隔符合并成文本（分隔符默认空串）
函数 内建_拼接(列表, 分隔符):
    如果 分隔符 == 空:
        分隔符 = ""
    令 r = ""
    遍历 i 在 范围(长度(列表)):
        如果 i > 0:
            r = r + 分隔符
        r = r + 内建_文本(列表[i])
    返回 r