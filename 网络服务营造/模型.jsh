# 模型 —— 注册式 ORM（基于内置 数据库 模块，SQLite）
# 模型是“注册的数据”，不是继承：模型_定义(名字, 字段们, 选项) 登记；之后用函数增删改查。
# 记录都是字典（含 id）。顶层名字统一 模型_ 前缀。

导入 数据库

# 模型注册表：名字 -> {名字, 表名, 字段们, 选项}
模型_注册表 = {}
# 数据库句柄状态：{"句柄": 库, "路径": 路径}
模型_库 = {}

# ---- 库管理 ----
函数 模型_设库(路径):
    令 库 = 数据库.打开(路径)
    模型_库["句柄"] = 库
    模型_库["路径"] = 路径

函数 模型_取库():
    如果 模型_库.包含("句柄"):
        返回 模型_库["句柄"]
    抛出 值错误("还没设置数据库：请先 模型_设库(路径)")

# ---- 定义与迁移 ----
函数 模型_定义(名字, 字段们, 选项 = 空):
    令 表 = 名字
    如果 选项 != 空 与 选项.包含("表名"):
        表 = 选项["表名"]
    模型_注册表[名字] = {"名字": 名字, "表名": 表, "字段们": 字段们, "选项": 选项}

函数 模型_取定义(名字):
    如果 模型_注册表.包含(名字):
        返回 模型_注册表[名字]
    抛出 值错误("没有定义过这个模型：" + 内建_文本(名字))

# 建单个模型对应的表
函数 模型_建表(名字):
    令 定义 = 模型_取定义(名字)
    令 库 = 模型_取库()
    数据库.建表(库, 定义["表名"], 定义["字段们"])
    如果 定义["选项"] != 空 与 定义["选项"].包含("索引"):
        遍历 字段们 在 定义["选项"]["索引"]:
            数据库.建索引(库, 定义["表名"], 字段们)

# 迁移：给所有已定义模型建表（幂等）
函数 模型_迁移():
    遍历 名字 在 模型_注册表.键():
        模型_建表(名字)

# ---- 增删改查 ----
函数 模型_全部(名字, 条件 = 空, 排序 = 空, 倒序 = 假, 条数 = 空):
    令 定义 = 模型_取定义(名字)
    令 库 = 模型_取库()
    返回 数据库.查询(库, 定义["表名"], 条件, 排序, 倒序, 条数)

函数 模型_过滤(名字, 条件 = 空, 排序 = 空, 倒序 = 假, 条数 = 空):
    返回 模型_全部(名字, 条件, 排序, 倒序, 条数)

函数 模型_取(名字, 条件 = 空):
    令 行们 = 模型_全部(名字, 条件, 空, 假, 1)
    如果 长度(行们) > 0:
        返回 行们[0]
    返回 空

函数 模型_取ID(名字, id):
    返回 模型_取(名字, {"id": id})

函数 模型_创建(名字, 记录):
    令 定义 = 模型_取定义(名字)
    令 库 = 模型_取库()
    令 id = 数据库.插入(库, 定义["表名"], 记录)
    记录["id"] = id
    返回 id

函数 模型_保存(名字, 记录):
    如果 记录.包含("id"):
        令 定义 = 模型_取定义(名字)
        令 库 = 模型_取库()
        令 新值 = {}
        遍历 k 在 记录.键():
            如果 k != "id":
                新值[k] = 记录[k]
        返回 数据库.修改(库, 定义["表名"], {"id": 记录["id"]}, 新值)
    否则:
        返回 模型_创建(名字, 记录)

函数 模型_删除(名字, 条件):
    令 定义 = 模型_取定义(名字)
    令 库 = 模型_取库()
    返回 数据库.删除(库, 定义["表名"], 条件)

函数 模型_删除ID(名字, id):
    返回 模型_删除(名字, {"id": id})

函数 模型_计数(名字, 条件 = 空):
    令 定义 = 模型_取定义(名字)
    令 库 = 模型_取库()
    返回 数据库.条数(库, 定义["表名"], 条件)

# ---- 分页 / 联表（0.3.5 方向扩展）----
# 分页：返回 {总数,页,每页,总页数,记录们,有上一页,有下一页,上一页,下一页}
函数 模型_分页(名字, 页 = 1, 每页 = 20, 条件 = 空, 排序 = 空, 倒序 = 假):
    如果 页 < 1:
        页 = 1
    如果 每页 < 1:
        每页 = 20
    令 全部 = 模型_全部(名字, 条件, 排序, 倒序)
    令 总数 = 长度(全部)
    令 起 = (页 - 1) * 每页
    令 止 = 起 + 每页
    如果 止 > 总数:
        止 = 总数
    令 记录们 = []
    如果 起 < 总数:
        记录们 = 全部[起:止]
    令 总页 = (总数 + 每页 - 1) // 每页
    如果 总页 < 1:
        总页 = 1
    返回 {
        "总数": 总数, "页": 页, "每页": 每页, "总页数": 总页,
        "记录们": 记录们,
        "有上一页": 页 > 1, "有下一页": 页 < 总页,
        "上一页": 页 - 1, "下一页": 页 + 1
    }

# 联表（内存预取，等价 Django 的 prefetch_related）：
# 主表.外键字段 == 从表.主键字段；给每条主记录挂一个 "_<从名字>" 列表
函数 模型_联表(主名字, 主键字段, 从名字, 外键字段, 条件 = 空):
    令 主记录们 = 模型_全部(主名字, 条件)
    令 从记录们 = 模型_全部(从名字)
    令 索引 = {}
    遍历 子 在 从记录们:
        令 k = 内建_文本(子[主键字段])
        如果 非 索引.包含(k):
            索引[k] = []
        索引[k].追加(子)
    遍历 主 在 主记录们:
        令 k = 内建_文本(主[外键字段])
        主["_" + 从名字] = 索引.获取(k, [])
    返回 主记录们

# 取某一列的所有值
函数 模型_列(名字, 字段, 条件 = 空):
    返回 模型_全部(名字, 条件).映射(函数(x): x[字段])

# 已注册的模型名列表
函数 模型_模型们():
    返回 模型_注册表.键()

# 这个模型定义过吗
函数 模型_有(名字):
    返回 模型_注册表.包含(名字)