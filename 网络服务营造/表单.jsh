# 表单 —— 字段定义、校验、渲染（Django 风格表单的轻量版）
# 字段是字典：{"名", "标签"?, "类型"?（文本/整数/小数/邮箱/选项/布尔/多行）, "必填"?, "选项们"?, "提示"?}
# 顶层名字统一 表单_ 前缀。

导入 正则

# 校验：返回 {"有效": 真/假, "错误": {名: 消息}, "清洗": {名: 值}}
函数 表单_校验(字段们, 数据):
    令 错误 = {}
    令 清洗 = {}
    遍历 字段 在 字段们:
        令 名 = 字段["名"]
        令 标签 = 字段.获取("标签", 名)
        令 值 = 数据.获取(名, "")
        如果 字段.获取("必填", 假) 与 内建_是空(值):
            错误[名] = "请填写" + 标签
            继续
        令 类型 = 字段.获取("类型", "文本")
        如果 内建_是空(值):
            清洗[名] = 值
        否则如果 类型 == "整数":
            尝试:
                清洗[名] = 整数(值)
            捕获 异常 为 ex:
                错误[名] = 标签 + "必须是整数"
        否则如果 类型 == "小数":
            尝试:
                清洗[名] = 小数(值)
            捕获 异常 为 ex2:
                错误[名] = 标签 + "必须是数字"
        否则如果 类型 == "邮箱":
            如果 正则.匹配("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$", 值):
                清洗[名] = 值
            否则:
                错误[名] = "邮箱格式不对"
        否则如果 类型 == "选项":
            如果 字段["选项们"].包含(值):
                清洗[名] = 值
            否则:
                错误[名] = "请选择一个有效的" + 标签
        否则:
            清洗[名] = 值
    返回 {"有效": 长度(错误.键()) == 0, "错误": 错误, "清洗": 清洗}

# 渲染：返回一段 <form> HTML
函数 表单_渲染(字段们, 提交到 = "", 按钮文字 = "提交", 数据 = 空, 错误 = 空, 方法 = "post"):
    如果 数据 == 空:
        数据 = {}
    如果 错误 == 空:
        错误 = {}
    令 部件们 = []
    遍历 字段 在 字段们:
        令 名 = 字段["名"]
        令 标签 = 字段.获取("标签", 名)
        令 类型 = 字段.获取("类型", "文本")
        令 值 = 内建_文本(数据.获取(名, ""))
        令 提示 = 字段.获取("提示", "")
        令 行 = []
        如果 类型 == "多行":
            行.追加("<label>" + 内建_转义(标签) + "</label>")
            行.追加("<textarea name=\"" + 内建_转义(名) + "\" rows=\"6\">" + 内建_转义(值) + "</textarea>")
        否则如果 类型 == "布尔":
            令 勾 = " checked" 如果 值 == "真" 或 值 == "1" 或 值 == "on" 否则 ""
            行.追加("<label><input type=\"checkbox\" name=\"" + 内建_转义(名) + "\" value=\"1\"" + 勾 + "> " + 内建_转义(标签) + "</label>")
        否则如果 类型 == "选项":
            行.追加("<label>" + 内建_转义(标签) + "</label>")
            令 选项们 = ["<select name=\"" + 内建_转义(名) + "\">"]
            遍历 选 在 字段["选项们"]:
                令 选值 = 内建_文本(选)
                令 sel = " selected" 如果 选值 == 值 否则 ""
                选项们.追加("<option value=\"" + 内建_转义(选值) + "\"" + sel + ">" + 内建_转义(选值) + "</option>")
            选项们.追加("</select>")
            行.追加(内建_拼接(选项们, ""))
        否则:
            令 输入类型 = "text"
            如果 类型 == "整数" 或 类型 == "小数":
                输入类型 = "number"
            否则如果 类型 == "邮箱":
                输入类型 = "email"
            行.追加("<label>" + 内建_转义(标签) + "</label>")
            行.追加("<input type=\"" + 输入类型 + "\" name=\"" + 内建_转义(名) + "\" value=\"" + 内建_转义(值) + "\">")
        如果 提示 != "":
            行.追加("<small class=\"表单提示\">" + 内建_转义(提示) + "</small>")
        如果 错误.包含(名):
            行.追加("<div class=\"表单错误\">" + 内建_转义(错误[名]) + "</div>")
        部件们.追加("<div class=\"字段\">" + 内建_拼接(行, "") + "</div>")
    令 动作 = (" action=\"" + 内建_转义(提交到) + "\"") 如果 提交到 != "" 否则 ""
    令 尾 = "<div class=\"字段\"><button type=\"submit\">" + 内建_转义(按钮文字) + "</button></div>"
    返回 "<form method=\"" + 方法 + "\"" + 动作 + ">" + 内建_拼接(部件们, "") + 尾 + "</form>"