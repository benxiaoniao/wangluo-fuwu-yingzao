# 请求 —— 请求对象，封装 HTTP服务端.解析请求 得到的原始字典
# 顶层名字：类 请求对象；函数 请求（供测试/手动构造）。
# 原始字典键：方法 / 路径 / 查询 / 版本 / 请求头 / 正文

导入 编码
导入 json

类 请求对象:
    函数 初始化(自身, 原始):
        自身.原始 = 原始
        自身.方法 = 内建_取(原始, "方法", "GET")
        自身.路径 = 内建_取(原始, "路径", "/")
        自身.查询 = 内建_取(原始, "查询", {})
        自身.请求头 = 内建_取(原始, "请求头", {})
        自身.版本 = 内建_取(原始, "版本", "HTTP/1.1")
        自身.正文 = 内建_取(原始, "正文", "")
        自身.表单 = 空      # 解析后的表单（惰性）
        自身.文件们 = 空
        自身.用户 = 空      # 认证中间件填入
        自身.会话 = 空      # 会话中间件填入
        自身.路径参数 = {}  # 路由填入

    # 方法判断
    函数 是方法(自身, 名):
        返回 自身.方法 == 名

    函数 是GET(自身):
        返回 自身.方法 == "GET"

    函数 是POST(自身):
        返回 自身.方法 == "POST"

    # 头读取（大小写不敏感）
    函数 头(自身, 名, 默认 = ""):
        遍历 k 在 自身.请求头.键():
            如果 k.小写() == 名.小写():
                返回 自身.请求头[k]
        返回 默认

    # 内容类型（去掉 ; charset=... 之后的部分）
    函数 内容类型(自身):
        令 ct = 自身.头("content-type", "")
        令 段 = ct.拆分(";")
        如果 长度(段) > 0:
            返回 段[0].去空白().小写()
        返回 ""

    # 取查询参数
    函数 查询取(自身, 键, 默认 = ""):
        返回 自身.查询.获取(键, 默认)

    # 解析表单（application/x-www-form-urlencoded），惰性只做一次
    函数 取表单(自身):
        如果 自身.表单 != 空:
            返回 自身.表单
        令 d = {}
        令 ct = 自身.内容类型()
        如果 ct == "application/x-www-form-urlencoded":
            令 正文 = 内建_文本(自身.正文)
            如果 正文 != "":
                遍历 对 在 正文.拆分("&"):
                    令 kv = 对.拆分("=")
                    如果 长度(kv) >= 1:
                        令 k = 编码.url解码(kv[0].替换("+", " "))
                        令 v = ""
                        如果 长度(kv) >= 2:
                            v = 编码.url解码(kv[1].替换("+", " "))
                        d[k] = v
        自身.表单 = d
        返回 d

    # 取单个表单值
    函数 表单取(自身, 键, 默认 = ""):
        返回 自身.取表单().获取(键, 默认)

    # GET/POST 合并取值（表单优先，再查询）
    函数 取值(自身, 键, 默认 = ""):
        令 f = 自身.取表单()
        如果 f.包含(键):
            返回 f[键]
        返回 自身.查询.获取(键, 默认)

    # 是不是 AJAX（X-Requested-With）
    函数 是AJAX(自身):
        返回 自身.头("x-requested-with", "") == "XMLHttpRequest"

    # 解析 JSON 请求体（application/json），失败抛 值错误
    函数 取JSON(自身):
        尝试:
            返回 json.解析(内建_文本(自身.正文))
        捕获 异常 为 e:
            抛出 值错误("请求体不是合法 JSON：" + e.消息)

    # 便捷：把请求体当 JSON 取，空体返回 空
    函数 JSON体(自身):
        如果 内建_是空(自身.正文):
            返回 空
        返回 自身.取JSON()

# 手动构造一个请求对象（测试用）
函数 请求(方法 = "GET", 路径 = "/", 查询 = 空, 正文 = "", 请求头 = 空):
    令 q = 查询
    如果 q == 空:
        q = {}
    令 h = 请求头
    如果 h == 空:
        h = {}
    令 原始 = {
        "方法": 方法,
        "路径": 路径,
        "查询": q,
        "版本": "HTTP/1.1",
        "请求头": h,
        "正文": 正文
    }
    返回 新建 请求对象(原始)