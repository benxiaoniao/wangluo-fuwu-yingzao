# 核心 —— 应用配置、请求分发、开发服务器（含自动刷新）、静态文件（含 ETag/304）
# 顶层名字统一 核心_ 前缀；对外：核心_默认配置 / 核心_运行。
# 自动刷新（0.3.7，M233 路径.监视 + 启动非阻塞）：调试模式下监视模板/静态目录，
# 文件一变就推进刷新版本；注入到 HTML 页的小脚本轮询 /网络服务营造/刷新探测，
# 版本变了就 location.reload()。本宿主不支持监视时自动退回阻塞服务模式。

导入 HTTP服务端
导入 文件
导入 路径
导入 时间

# 当前应用的配置（模块级状态；0.3.6 起函数内可直接下标写）
核心_配置 = {}
# 自动刷新状态：版本号（文件一变就 +1）、监视器是否活着、监视句柄们、变化提示节流
核心_刷新状态 = {"版本": 1}
核心_刷新监视 = {"开": 假}
核心_监视器们 = []
核心_上次变化提示 = {"时间": 0, "路径": ""}

函数 核心_默认配置():
    返回 {
        "调试": 真,
        "主机": "127.0.0.1",
        "端口": 8000,
        "数据库": "",
        "模板目录": "模板",
        "静态目录": "静态",
        "静态前缀": "/静态/",
        "密钥": "网络服务营造开发密钥",
        "路由": 空,
        "中间件": [],
        "自动刷新": 真
    }

# 启动开发服务器（阻塞）
# 0.3.6 起（W3 已修）模块级字典可以直接下标写，不再需要「别名法」。
函数 核心_运行(配置):
    核心_配置.清空()
    核心_配置.更新(配置)
    如果 非 核心_配置.包含("调试"):
        核心_配置["调试"] = 真
    如果 非 核心_配置.包含("端口"):
        核心_配置["端口"] = 8000
    如果 非 核心_配置.包含("静态前缀"):
        核心_配置["静态前缀"] = "/静态/"
    # 静态前缀统一以 / 结尾（静态切片按前缀长度进行，少一层斜杠会切错）
    如果 非 核心_配置["静态前缀"].结尾是("/"):
        核心_配置["静态前缀"] = 核心_配置["静态前缀"] + "/"
    如果 非 核心_配置.包含("静态目录"):
        核心_配置["静态目录"] = "静态"
    如果 非 核心_配置.包含("模板目录"):
        核心_配置["模板目录"] = "模板"
    如果 非 核心_配置.包含("数据库"):
        核心_配置["数据库"] = ""
    如果 非 核心_配置.包含("中间件"):
        核心_配置["中间件"] = []

    模板_设目录(核心_配置["模板目录"])
    如果 核心_配置["数据库"] != "":
        模型_设库(核心_配置["数据库"])
        模型_迁移()

    中间件_清空()
    遍历 mw 在 核心_配置["中间件"]:
        中间件_加(mw)

    如果 核心_配置["路由"] == 空:
        抛出 值错误("配置里必须提供「路由」（一个 路由表）")

    打印("网络服务营造 开发服务器")
    打印(`  监听 http://{核心_配置["主机"]}:{核心_配置["端口"]}/`)
    打印(`  调试模式：{核心_配置["调试"]}`)
    打印("  按 Ctrl+C 停止")

    # 自动刷新：调试 + 自动刷新 都开、且本宿主支持 路径.监视 时，走非阻塞服务循环
    # （循环里一边处理请求一边派发文件变化事件）；否则照旧阻塞服务。
    如果 核心_配置.获取("自动刷新", 真) 与 核心_配置["调试"] 与 核心_起监视器们():
        核心_刷新监视["开"] = 真
        打印("  自动刷新：开（改动模板/静态后浏览器自动重载）")
        核心_服务循环()
    否则:
        打印("  自动刷新：关")
        HTTP服务端.启动(核心_配置["端口"], 核心_处理, 0)

# 给模板/静态目录挂监视器（0.3.7 路径.监视，Rust 宿主专用；挂不上返回假）
函数 核心_起监视器们():
    核心_监视器们.清空()
    令 目录们 = [核心_配置["模板目录"], 核心_配置["静态目录"]]
    遍历 目录 在 目录们:
        如果 目录 == "" 或 非 文件.是目录(目录):
            继续
        尝试:
            核心_监视器们.追加(路径.监视(目录, 核心_文件变了, {"递归": 真}))
        捕获 异常 为 e:
            打印("  （本宿主不支持 路径.监视：" + e.消息 + "）")
            遍历 表 在 核心_监视器们:
                路径.停止监视(表)
            核心_监视器们.清空()
            返回 假
    返回 长度(核心_监视器们) > 0

# 监视回调：推进刷新版本（提示打印做 1 秒节流，一次保存常触发多条事件）
函数 核心_文件变了(变化):
    核心_刷新状态["版本"] = 核心_刷新状态["版本"] + 1
    令 现在 = 时间.时间戳()
    如果 现在 - 核心_上次变化提示["时间"] > 1 或 变化["路径"] != 核心_上次变化提示["路径"]:
        打印(`[自动刷新] {变化["动作"]} {变化["路径"]}`)
    核心_上次变化提示["时间"] = 现在
    核心_上次变化提示["路径"] = 变化["路径"]

# 非阻塞服务循环：处理请求 + 派发文件变化事件（各让一步，都不等死）
函数 核心_服务循环():
    令 句柄 = HTTP服务端.启动非阻塞(核心_配置["端口"], 核心_处理, 0)
    当 真:
        句柄.处理一轮()
        遍历 表 在 核心_监视器们:
            路径.等事件(表, 0.02)

# 每个请求的入口（HTTP服务端 调用它）
函数 核心_处理(请求字典):
    尝试:
        返回 核心_分发(核心_配置, 请求字典)
    捕获 异常 为 e:
        如果 核心_配置["调试"]:
            返回 错误响应(500, "服务器内部错误：" + e.消息).输出()
        返回 错误响应(500, "服务器内部错误").输出()

# 分发一个请求，返回完整 HTTP 响应文本（字节正文时返回完整响应字节）
函数 核心_分发(配置, 请求字典):
    令 req = 新建 请求对象(请求字典)

    # HEAD 当 GET 处理：用 GET 匹配、跑视图，最后清空响应体
    令 是HEAD = (req.方法 == "HEAD")
    如果 是HEAD:
        req.方法 = "GET"

    如果 req.路径.开头是(配置["静态前缀"]):
        令 sr = 核心_静态(配置, req)
        如果 是HEAD:
            sr.内容 = ""
        返回 sr.输出()

    如果 req.路径 == "/网络服务营造/刷新探测":
        返回 JSON响应({"版本": 核心_刷新状态["版本"], "开": 核心_刷新监视["开"]}).输出()

    如果 req.路径.开头是("/网络服务营造/"):
        返回 前端_处理(配置, req)

    令 路由 = 配置["路由"]

    令 命中 = 路由.解析(req.方法, req.路径)
    如果 命中 == 空:
        令 允许 = 路由.其他方法(req.方法, req.路径)
        如果 长度(允许) > 0:
            返回 方法不允许(允许).输出()
        返回 未找到().输出()

    req.路径参数 = 命中["参数"]
    令 结果 = 中间件_执行(req, 命中["处理"], 命中["参数"])
    如果 是实例(结果, 响应对象):
        核心_注入刷新(结果)
        如果 是HEAD:
            结果.内容 = ""
        返回 结果.输出()
    如果 是HEAD:
        返回 响应("").输出()
    令 默认响应 = 响应(内建_文本(结果))
    核心_注入刷新(默认响应)
    返回 默认响应.输出()

# 往 HTML 响应里注入自动刷新小脚本（仅监视模式开启、text/html、有 </body> 时）
函数 核心_注入刷新(r):
    如果 非 核心_刷新监视["开"]:
        返回
    如果 非 r.内容类型.开头是("text/html"):
        返回
    如果 类型(r.内容) != "文本":
        返回
    如果 非 r.内容.包含("</body>"):
        返回
    令 段 = r.内容.拆分("</body>")
    r.内容 = 段[0] + 核心_刷新脚本() + "</body>" + 内建_拼接(段[1:], "</body>")

# 注入的脚本：1 秒一轮询刷新版本，变了就整页重载
函数 核心_刷新脚本():
    令 v = 核心_刷新状态["版本"]
    返回 "<script>(function(){var v=" + 内建_文本(v) + ";setInterval(function(){fetch('/网络服务营造/刷新探测?版本='+v,{cache:'no-store'}).then(function(r){return r.json()}).then(function(j){if(j.版本!=v){location.reload();}}).catch(function(){})},1000);})();</script>"

# 静态文件：文本类按 charset 直出、二进制类走字节通道（0.3.6）、未知扩展按字节直出；
# 统一走 文件响应（ETag/304 协商缓存）。返回 响应对象（HEAD 由 核心_分发 清体）。
# 相对路径含 .. 或 \\ 一律 404 —— 路径.连接 会原样保留 ..，文件存在 又能解析出去，
# 不挡的话 /静态/../manage.jsh 能读到入口脚本源码（实测穿越成立）。
函数 核心_静态(配置, req):
    令 前缀 = 配置["静态前缀"]
    令 相对 = req.路径[长度(前缀):长度(req.路径)]
    如果 相对 == "" 或 相对.包含("..") 或 相对.包含(字符(92)):
        返回 未找到()
    令 全 = 路径.连接(配置["静态目录"], 相对)
    如果 非 (文件.文件存在(全) 与 文件.是文件(全)):
        返回 未找到()
    令 扩展 = 文件.扩展名(全).小写()
    令 类型 = 核心_字节类型(扩展)
    如果 类型 == "":
        类型 = 核心_类型(扩展)
    如果 类型 == "":
        类型 = "application/octet-stream"
    返回 文件响应(全, 类型, req)

# 文本类扩展名 → Content-Type（带 charset）；不在表里给 ""（由 核心_静态 走字节通道）
函数 核心_类型(扩展):
    如果 扩展 == ".css":
        返回 "text/css; charset=utf-8"
    如果 扩展 == ".js":
        返回 "application/javascript; charset=utf-8"
    如果 扩展 == ".html" 或 扩展 == ".htm":
        返回 "text/html; charset=utf-8"
    如果 扩展 == ".svg":
        返回 "image/svg+xml"
    如果 扩展 == ".json":
        返回 "application/json; charset=utf-8"
    如果 扩展 == ".txt" 或 扩展 == ".md" 或 扩展 == ".csv":
        返回 "text/plain; charset=utf-8"
    如果 扩展 == ".xml":
        返回 "application/xml; charset=utf-8"
    返回 ""

# 二进制扩展名 → Content-Type（0.3.6 起静态文件可走 构造响应 的字节通道直出）
函数 核心_字节类型(扩展):
    令 表 = {
        ".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".gif": "image/gif",
        ".webp": "image/webp", ".ico": "image/x-icon", ".bmp": "image/bmp",
        ".woff": "font/woff", ".woff2": "font/woff2", ".ttf": "font/ttf", ".otf": "font/otf",
        ".wasm": "application/wasm",
        ".mp3": "audio/mpeg", ".wav": "audio/wav", ".ogg": "audio/ogg",
        ".mp4": "video/mp4", ".webm": "video/webm",
        ".pdf": "application/pdf", ".zip": "application/zip"
    }
    返回 表.获取(扩展, "")

# 快捷：渲染模板为响应（视图里最常用）
函数 渲染(模板名, 上下文 = 空):
    如果 上下文 == 空:
        上下文 = {}
    返回 响应(模板_渲染文件(模板名, 上下文))