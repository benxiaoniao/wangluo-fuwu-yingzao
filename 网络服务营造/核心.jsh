# 核心 —— 应用配置、请求分发、开发服务器、静态文件
# 顶层名字统一 核心_ 前缀；对外：核心_默认配置 / 核心_运行。

导入 HTTP服务端
导入 文件
导入 路径

# 当前应用的配置（模块级状态；0.3.6 起函数内可直接下标写）
核心_配置 = {}

函数 核心_默认配置():
    返回 {
        "调试": 真,
        "主机": "127.0.0.1",
        "端口": 8000,
        "数据库": "",
        "模板目录": "模板",
        "静态目录": "静态",
        "静态前缀": "/静态/",
        "密钥": "网络服务营造开发密钥",
        "路由": 空,
        "中间件": []
    }

# 启动开发服务器（阻塞）
# 0.3.6 起（W3 已修）模块级字典可以直接下标写，不再需要「别名法」。
函数 核心_运行(配置):
    核心_配置.清空()
    核心_配置.更新(配置)
    如果 非 核心_配置.包含("调试"):
        核心_配置["调试"] = 真
    如果 非 核心_配置.包含("端口"):
        核心_配置["端口"] = 8000
    如果 非 核心_配置.包含("静态前缀"):
        核心_配置["静态前缀"] = "/静态/"
    # 静态前缀统一以 / 结尾（静态切片按前缀长度进行，少一层斜杠会切错）
    如果 非 核心_配置["静态前缀"].结尾是("/"):
        核心_配置["静态前缀"] = 核心_配置["静态前缀"] + "/"
    如果 非 核心_配置.包含("静态目录"):
        核心_配置["静态目录"] = "静态"
    如果 非 核心_配置.包含("模板目录"):
        核心_配置["模板目录"] = "模板"
    如果 非 核心_配置.包含("数据库"):
        核心_配置["数据库"] = ""
    如果 非 核心_配置.包含("中间件"):
        核心_配置["中间件"] = []

    模板_设目录(核心_配置["模板目录"])
    如果 核心_配置["数据库"] != "":
        模型_设库(核心_配置["数据库"])
        模型_迁移()

    中间件_清空()
    遍历 mw 在 核心_配置["中间件"]:
        中间件_加(mw)

    如果 核心_配置["路由"] == 空:
        抛出 值错误("配置里必须提供「路由」（一个 路由表）")

    打印("网络服务营造 开发服务器")
    打印(`  监听 http://{核心_配置["主机"]}:{核心_配置["端口"]}/`)
    打印(`  调试模式：{核心_配置["调试"]}`)
    打印("  按 Ctrl+C 停止")

    HTTP服务端.启动(核心_配置["端口"], 核心_处理, 0)

# 每个请求的入口（HTTP服务端 调用它）
函数 核心_处理(请求字典):
    尝试:
        返回 核心_分发(核心_配置, 请求字典)
    捕获 异常 为 e:
        如果 核心_配置["调试"]:
            返回 错误响应(500, "服务器内部错误：" + e.消息).输出()
        返回 错误响应(500, "服务器内部错误").输出()

# 分发一个请求，返回完整 HTTP 响应文本（字节正文时返回完整响应字节）
函数 核心_分发(配置, 请求字典):
    令 req = 新建 请求对象(请求字典)

    # HEAD 当 GET 处理：用 GET 匹配、跑视图，最后清空响应体
    令 是HEAD = (req.方法 == "HEAD")
    如果 是HEAD:
        req.方法 = "GET"

    如果 req.路径.开头是(配置["静态前缀"]):
        令 sr = 核心_静态(配置, req)
        如果 是HEAD:
            sr.内容 = ""
        返回 sr.输出()

    如果 req.路径.开头是("/网络服务营造/"):
        返回 前端_处理(配置, req)

    令 路由 = 配置["路由"]

    令 命中 = 路由.解析(req.方法, req.路径)
    如果 命中 == 空:
        令 允许 = 路由.其他方法(req.方法, req.路径)
        如果 长度(允许) > 0:
            返回 方法不允许(允许).输出()
        返回 未找到().输出()

    req.路径参数 = 命中["参数"]
    令 结果 = 中间件_执行(req, 命中["处理"], 命中["参数"])
    如果 是实例(结果, 响应对象):
        如果 是HEAD:
            结果.内容 = ""
        返回 结果.输出()
    如果 是HEAD:
        返回 响应("").输出()
    返回 响应(内建_文本(结果)).输出()

# 静态文件：文本类读文本、二进制类走字节通道（0.3.6）、未知扩展按字节直出；
# 返回 响应对象（HEAD 由 核心_分发 清体）。
# 相对路径含 .. 或 \\ 一律 404 —— 路径.连接 会原样保留 ..，文件存在 又能解析出去，
# 不挡的话 /静态/../manage.jsh 能读到入口脚本源码（实测穿越成立）。
函数 核心_静态(配置, req):
    令 前缀 = 配置["静态前缀"]
    令 相对 = req.路径[长度(前缀):长度(req.路径)]
    如果 相对 == "" 或 相对.包含("..") 或 相对.包含(字符(92)):
        返回 未找到()
    令 全 = 路径.连接(配置["静态目录"], 相对)
    如果 非 (文件.文件存在(全) 与 文件.是文件(全)):
        返回 未找到()
    令 扩展 = 文件.扩展名(全).小写()
    令 字节类型 = 核心_字节类型(扩展)
    如果 字节类型 != "":
        返回 字节响应(文件.读字节(全), 字节类型)
    令 文本类型 = 核心_类型(扩展)
    如果 文本类型 != "":
        返回 响应(文件.读文本(全), 200, 文本类型)
    返回 字节响应(文件.读字节(全), "application/octet-stream")

# 文本类扩展名 → Content-Type（带 charset）；不在表里给 ""（由 核心_静态 走字节通道）
函数 核心_类型(扩展):
    如果 扩展 == ".css":
        返回 "text/css; charset=utf-8"
    如果 扩展 == ".js":
        返回 "application/javascript; charset=utf-8"
    如果 扩展 == ".html" 或 扩展 == ".htm":
        返回 "text/html; charset=utf-8"
    如果 扩展 == ".svg":
        返回 "image/svg+xml"
    如果 扩展 == ".json":
        返回 "application/json; charset=utf-8"
    如果 扩展 == ".txt" 或 扩展 == ".md" 或 扩展 == ".csv":
        返回 "text/plain; charset=utf-8"
    如果 扩展 == ".xml":
        返回 "application/xml; charset=utf-8"
    返回 ""

# 二进制扩展名 → Content-Type（0.3.6 起静态文件可走 构造响应 的字节通道直出）
函数 核心_字节类型(扩展):
    令 表 = {
        ".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".gif": "image/gif",
        ".webp": "image/webp", ".ico": "image/x-icon", ".bmp": "image/bmp",
        ".woff": "font/woff", ".woff2": "font/woff2", ".ttf": "font/ttf", ".otf": "font/otf",
        ".wasm": "application/wasm",
        ".mp3": "audio/mpeg", ".wav": "audio/wav", ".ogg": "audio/ogg",
        ".mp4": "video/mp4", ".webm": "video/webm",
        ".pdf": "application/pdf", ".zip": "application/zip"
    }
    返回 表.获取(扩展, "")

# 快捷：渲染模板为响应（视图里最常用）
函数 渲染(模板名, 上下文 = 空):
    如果 上下文 == 空:
        上下文 = {}
    返回 响应(模板_渲染文件(模板名, 上下文))