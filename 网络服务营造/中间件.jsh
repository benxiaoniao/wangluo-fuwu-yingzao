# 中间件 —— 前置 / 后置 链
# 中间件是字典：{"前置": 函数(请求)->响应或空, "后置": 函数(请求, 响应)->响应}
# 前置返回非空则短路（直接作为响应）；后置按注册的逆序执行。
# 顶层名字统一 中间件_ 前缀。

中间件_链 = []

函数 中间件_加(中间件):
    中间件_链.追加(中间件)

函数 中间件_清空():
    中间件_链.清空()

# 执行：前置 → 视图(请求, 参数) → 后置(逆序)
函数 中间件_执行(请求, 视图, 参数):
    遍历 mw 在 中间件_链:
        令 结果 = mw["前置"](请求)
        如果 结果 != 空:
            返回 结果
    令 响应 = 视图(请求, 参数)
    遍历 i 在 范围(长度(中间件_链)):
        令 idx = 长度(中间件_链) - 1 - i
        响应 = 中间件_链[idx]["后置"](请求, 响应)
    返回 响应

# 一个简单的访问日志中间件（写到标准输出）
函数 中间件_日志_前置(请求):
    打印(`[网络服务营造] {请求.方法} {请求.路径}`)
    返回 空

函数 中间件_日志_后置(请求, 响应):
    返回 响应

函数 中间件_日志():
    返回 {"前置": 中间件_日志_前置, "后置": 中间件_日志_后置}

# ---- 跨域（CORS）----
函数 中间件_跨域_前置(请求):
    如果 请求.方法 == "OPTIONS":
        令 r = 新建 响应对象("", 204)
        r.设头("Access-Control-Allow-Origin", "*")
        r.设头("Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, OPTIONS")
        r.设头("Access-Control-Allow-Headers", "Content-Type, Authorization")
        r.设头("Access-Control-Max-Age", "86400")
        返回 r
    返回 空

函数 中间件_跨域_后置(请求, 响应):
    响应.设头("Access-Control-Allow-Origin", "*")
    响应.设头("Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, OPTIONS")
    响应.设头("Access-Control-Allow-Headers", "Content-Type, Authorization")
    返回 响应

函数 中间件_跨域():
    返回 {"前置": 中间件_跨域_前置, "后置": 中间件_跨域_后置}