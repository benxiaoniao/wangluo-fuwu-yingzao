# 在 语言问题复现\包问题 目录下跑：jishi run_W3_W4.jsh
导入 丙 从 本地包 为 丙

函数 试(名, 动作):
    尝试:
        动作()
        返回 名 + " => OK"
    捕获 异常 为 e:
        返回 名 + " => 失败：" + e.消息

打印(试("设x_直接(2)  ", 函数(): 丙.设x_直接(2)))
打印(试("设x_别名(3)   ", 函数(): 丙.设x_别名(3)))
打印("别名后 取x() = " + 文本(丙.取x()))
打印(试("设y_类属性(9) ", 函数(): 丙.设y_类属性(9)))