# 简易博客 —— 网络服务营造框架的端到端示例
# 跑法（在仓库根目录 D:\code\营造框架 下）：jishi 示例\博客\manage.jsh
# 然后浏览器打开 http://127.0.0.1:8092/
#
# 演示内容：
#   - 后端：路由 / 请求 / 响应 / 模板 / ORM / 表单 / 会话 / 中间件（全部基石）
#   - 前端：/前端 页的“文章列表 + 搜索”组件是基石写的，经官方 WASM 在浏览器运行，
#           通过 /api/文章 拉取后端（也是基石）的数据。

导入 网络服务营造 从 本地包 为 网造
导入 文件
导入 路径
导入 时间

# 项目根（相对仓库根目录）
函数 根目录():
    返回 "示例/博客"

# 文章表单字段
函数 文章字段们():
    返回 [
        {"名": "标题", "类型": "文本", "必填": 真, "提示": "给文章起个名字"},
        {"名": "分类", "类型": "选项", "选项们": ["随笔", "技术", "生活"], "必填": 真},
        {"名": "正文", "类型": "多行", "必填": 真, "提示": "正文，支持换行"}
    ]

# ---- 视图（每个视图：函数(请求, 路径参数) -> 响应）----

函数 视图_列表(请求, 参数):
    令 文章列表 = 网造.模型_全部("文章", 空, "id", 真)
    返回 网造.渲染("列表.html", {"文章列表": 文章列表, "提示": 网造.提示_渲染(网造.会话_取提示(请求))})

函数 视图_详情(请求, 参数):
    令 文章 = 网造.模型_取ID("文章", 参数["文章id"])
    如果 文章 == 空:
        返回 网造.未找到("文章不存在")
    文章["浏览数"] = 文章["浏览数"] + 1
    网造.模型_保存("文章", 文章)
    返回 网造.渲染("详情.html", {"文章": 文章})

函数 视图_新建(请求, 参数):
    如果 请求.是GET():
        返回 网造.渲染("新建.html", {"表单": 网造.表单_渲染(文章字段们(), "/文章/新建", "发布"), "错误": 假})
    令 校验 = 网造.表单_校验(文章字段们(), 请求.取表单())
    如果 校验["有效"]:
        令 清洗 = 校验["清洗"]
        清洗["浏览数"] = 0
        清洗["创建时间"] = 时间.现在()
        网造.模型_创建("文章", 清洗)
        网造.会话_设提示(请求, "成功", "文章发布成功")
        返回 网造.重定向("/")
    返回 网造.渲染("新建.html", {
        "表单": 网造.表单_渲染(文章字段们(), "/文章/新建", "发布", 请求.取表单(), 校验["错误"]),
        "错误": 真
    })

函数 视图_前端(请求, 参数):
    令 组件 = 文件.读文本(根目录() + "/组件/文章列表.jsh")
    令 主体 = "<div class=\"搜索条\"><input id=\"搜索\" placeholder=\"搜索标题…\"></div><div id=\"文章列表\"><p class=\"弱\">加载中…</p></div>"
    令 页 = 网造.前端_宿主页("前端演示 · 我的博客", 组件, {"主体": 主体})
    返回 网造.响应(页)

函数 视图_API文章(请求, 参数):
    如果 请求.方法 == "POST":
        令 数据 = 请求.取JSON()
        如果 类型(数据) != "字典" 或 非 数据.包含("标题") 或 网造.内建_是空(数据["标题"]):
            返回 网造.JSON响应({"错误": "缺少标题"}, 400)
        令 id = 网造.模型_创建("文章", {
            "标题": 数据["标题"],
            "正文": 数据.获取("正文", ""),
            "分类": 数据.获取("分类", "随笔"),
            "浏览数": 0,
            "创建时间": 时间.现在()
        })
        返回 网造.JSON响应({"ok": 真, "id": id}, 201)
    返回 网造.JSON响应(网造.模型_全部("文章", 空, "id", 真))

函数 视图_上传(请求, 参数):
    如果 请求.是GET():
        返回 网造.渲染("上传.html", {"结果": ""})
    # 图片：前端把文件读成 dataURL，用 JSON 提交（请求正文仍是文本层，见 W5 请求侧）
    # 落盘后回传文件网址 —— 0.3.6 起静态文件可直发二进制，<img> 引用真文件而不是 dataURL
    如果 请求.内容类型() == "application/json":
        令 d = 请求.取JSON()
        令 上传目录 = 根目录() + "/静态/上传"
        令 保存 = 网造.上传_保存dataurl(d["预览"], 上传目录)
        令 网址 = "/静态/上传/" + 路径.文件名(保存["路径"])
        网造.上传_记索引(上传目录, {"名": d.获取("名", "图片"), "预览": 保存["预览"], "路径": 保存["路径"], "网址": 网址})
        返回 网造.JSON响应({"ok": 真, "路径": 保存["路径"], "网址": 网址, "预览": 保存["预览"]})
    # 文本文件：multipart 直接上传
    令 上 = 网造.上传_解析(请求)
    令 文件们 = 上["文件们"]
    如果 长度(文件们) == 0:
        返回 网造.渲染("上传.html", {"结果": "没收到文件"})
    令 保存们 = []
    遍历 文件信息 在 文件们:
        令 p = 网造.上传_保存(文件信息, 根目录() + "/静态/上传")
        保存们.追加(网造.内建_转义(文件信息["文件名"]) + " → " + 网造.内建_转义(路径.文件名(p)))
    返回 网造.渲染("上传.html", {"结果": 网造.内建_拼接(保存们, "<br>")})

# ---- 组装并启动 ----
令 根 = 根目录()

网造.前端_设运行时目录(根 + "/静态/前端")
文件.创建目录(根 + "/静态/上传")

网造.模型_设库(根 + "/blog.db")
网造.模型_定义("文章", ["标题", "正文", "分类", "浏览数", "创建时间"])
网造.模型_迁移()

# 首次运行塞两篇示例文章
如果 网造.模型_计数("文章") == 0:
    网造.模型_创建("文章", {"标题": "欢迎来到网络服务营造", "正文": "这是用基石语言写的全栈博客。\n后端、模板、ORM、表单都是基石；前端组件也是基石，经官方 WASM 在浏览器运行。", "分类": "随笔", "浏览数": 0, "创建时间": 时间.现在()})
    网造.模型_创建("文章", {"标题": "框架的模块一览", "正文": "请求/响应、路由、模板、ORM、表单、会话、中间件、核心、前端。", "分类": "技术", "浏览数": 0, "创建时间": 时间.现在()})

令 路由 = 新建 网造.路由表()
路由.加("/", 视图_列表, ["GET"], "首页")
路由.加("/文章/新建", 视图_新建, ["GET", "POST"])
路由.加("/文章/<int:文章id>", 视图_详情, ["GET"], "详情")
路由.加("/前端", 视图_前端, ["GET"])
路由.加("/上传", 视图_上传, ["GET", "POST"])
路由.加("/api/文章", 视图_API文章, ["GET", "POST"])

# 管理后台（默认 /后台/，口令 admin123）
网造.后台_配置({"标题": "博客后台", "用户": "admin", "口令": "admin123", "上传目录": 根 + "/静态/上传"})
网造.后台_挂载(路由, "/后台")

令 配置 = 网造.核心_默认配置()
配置["路由"] = 路由
配置["数据库"] = 根 + "/blog.db"
配置["模板目录"] = 根 + "/模板"
配置["静态目录"] = 根 + "/静态"
配置["端口"] = 8092
配置["调试"] = 真
配置["中间件"] = [网造.会话_中间件()]

网造.核心_运行(配置)