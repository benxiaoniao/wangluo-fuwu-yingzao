# 前端组件（基石 → WASM，在浏览器里运行）
# 演示：向 /api/文章 拉取文章（后端也是基石），渲染列表，支持按标题搜索。
# 组件每次事件都会被“重跑一遍再调处理函数”，所以数据用 存本地 持久化，避免每次重新拉取。

导入 浏览器
导入 json
导入 html
导入 文本 为 文本库

函数 渲染(数据, 关键词):
    令 项们 = []
    遍历 a 在 数据:
        如果 关键词 == "" 或 a["标题"].包含(关键词):
            项们.追加("<li><a href=\"/文章/" + 文本(a["id"]) + "\">" + html.转义(a["标题"]) + "</a><span class=\"浏览\">" + 文本(a["浏览数"]) + " 次浏览 · " + html.转义(a["分类"]) + "</span></li>")
    如果 长度(项们) == 0:
        浏览器.设HTML("#文章列表", "<p class=\"弱\">没有匹配的文章。</p>")
    否则:
        浏览器.设HTML("#文章列表", "<ul class=\"文章列表\">" + 文本库.拼接(项们, "") + "</ul>")

函数 收到(响应文本):
    浏览器.存本地("网造_文章", 响应文本)
    渲染(json.解析(响应文本), 浏览器.取值("#搜索"))

函数 搜索():
    令 原始 = 浏览器.读本地("网造_文章")
    如果 原始 == 空:
        返回
    渲染(json.解析(原始), 浏览器.取值("#搜索"))

# 首次加载：绑定搜索框；没拉过就拉，拉过就直接渲染缓存（避免刷新后卡在“加载中”）
浏览器.绑定("#搜索", "input", "搜索")

如果 浏览器.读本地("网造_已加载") == 空:
    浏览器.存本地("网造_已加载", "1")
    浏览器.请求("/api/文章", "收到")
否则:
    令 旧 = 浏览器.读本地("网造_文章")
    如果 旧 != 空:
        渲染(json.解析(旧), 浏览器.取值("#搜索"))