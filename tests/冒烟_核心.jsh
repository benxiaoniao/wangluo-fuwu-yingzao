# 冒烟：内建 / 响应 / 请求
导入 网络服务营造 从 本地包 为 网造
导入 文件
导入 路径
导入 json
导入 编码

令 目录 = 路径.临时目录("网造冒烟")
令 结果 = {}

# ---- 响应 ----
令 r = 网造.响应("<b>你好</b>", 200)
r.设cookie("sid", "abc123", {"路径": "/", "仅HTTP": 真})
r.设头("X-Powered-By", "网络服务营造")
令 输出 = r.输出()
文件.写文本(路径.连接(目录, "resp.txt"), 输出)

# ---- 重定向 ----
令 r2 = 网造.重定向("/login", 302)
文件.写文本(路径.连接(目录, "redir.txt"), r2.输出())

# ---- JSON ----
令 r3 = 网造.JSON响应({"ok": 真, "列表": [1, 2, 3]})
文件.写文本(路径.连接(目录, "json.txt"), r3.输出())

# ---- 字节响应（0.3.6 二进制出口：输出走 构造响应 字节通道） ----
令 rb = 网造.字节响应(编码.十六进制解码("89504e470d0a1a0a"), "image/png")
令 字节输出 = rb.输出()
结果["字节响应_输出类型"] = 类型(字节输出)
# 输出的完整响应字节应以 PNG 魔数（正文）结尾 —— 证明字节没被 UTF-8 重编码
结果["字节响应_正文结尾"] = 编码.十六进制编码(字节输出).结尾是("89504e470d0a1a0a")
文件.写字节(路径.连接(目录, "resp.bin"), 字节输出)

# 字节响应 + 多 Set-Cookie（头走名字/值对列表）
# 注意：字节正文走 构造响应，头值只能 ASCII（W18）—— cookie 名/值须 ASCII
令 rb2 = 网造.字节响应(编码.十六进制解码("00ff"), "image/png")
rb2.设cookie("sid", "x1", {"路径": "/"})
rb2.设cookie("theme", "dark")
令 字节输出2 = rb2.输出()
结果["字节响应_cookie输出类型"] = 类型(字节输出2)

# 文件下载（字节正文 + filename*）
令 rd = 网造.文件下载(编码.文本字节("下载内容"), "报告.txt")
结果["下载_头"] = rd.头["Content-Disposition"]
令 rd2 = 网造.下载文件(路径.连接(目录, "resp.txt"), "改名.txt")
结果["下载_文件头"] = rd2.头["Content-Disposition"]
结果["下载_文件字节"] = 类型(rd2.内容)

# ---- 请求：表单解析 ----
令 req = 网造.请求("POST", "/submit", {"a": "1"}, "x=1&y=" + 网造.内建_文本("中"), {"Content-Type": "application/x-www-form-urlencoded"})
结果["表单"] = req.取表单()
结果["取值x"] = req.取值("x")
结果["查询a"] = req.查询取("a")

# ---- 请求：头大小写 ----
结果["头content-type"] = req.头("Content-Type")

# ---- 转义 ----
结果["转义"] = 网造.内建_转义("<a href=\"x\">&'")

# ---- 状态原因 ----
结果["状态404"] = 网造.内建_状态原因(404)

文件.写文本(路径.连接(目录, "result.json"), json.转文本(结果, 2))
打印("冒烟目录：" + 目录)