# 冒烟：模型 ORM
导入 网络服务营造 从 本地包 为 网造
导入 文件
导入 路径
导入 json

令 目录 = 路径.临时目录("网造模型")
网造.模型_设库(路径.连接(目录, "blog.db"))

网造.模型_定义("文章", ["标题", "正文", "浏览数"], {"索引": [["标题"]]})
网造.模型_迁移()

令 结果 = {}

令 id1 = 网造.模型_创建("文章", {"标题": "第一篇", "正文": "内容一", "浏览数": 10})
令 id2 = 网造.模型_创建("文章", {"标题": "第二篇", "正文": "内容二", "浏览数": 30})
令 id3 = 网造.模型_创建("文章", {"标题": "第三篇", "正文": "内容三", "浏览数": 20})
结果["创建id"] = [id1, id2, id3]

结果["计数"] = 网造.模型_计数("文章")

# 全部按浏览数倒序
结果["全部_倒序标题"] = 网造.模型_全部("文章", 空, "浏览数", 真).映射(函数(x): x["标题"])

# 取单个
令 一 = 网造.模型_取ID("文章", id2)
结果["取id2"] = 一

# 条件过滤
结果["浏览数大于15"] = 网造.模型_过滤("文章", {"浏览数": {">": 15}}).映射(函数(x): x["标题"])

# 修改
一["浏览数"] = 99
网造.模型_保存("文章", 一)
结果["改后id2浏览数"] = 网造.模型_取ID("文章", id2)["浏览数"]

# 删除
网造.模型_删除ID("文章", id1)
结果["删后计数"] = 网造.模型_计数("文章")
结果["删后剩余标题"] = 网造.模型_全部("文章").映射(函数(x): x["标题"])

文件.写文本(路径.连接(目录, "result.json"), json.转文本(结果, 2))
打印("模型冒烟目录：" + 目录)