# 冒烟：表单
导入 网络服务营造 从 本地包 为 网造
导入 文件
导入 路径
导入 json

令 字段们 = [
    {"名": "标题", "类型": "文本", "必填": 真, "提示": "给文章起个名字"},
    {"名": "浏览数", "类型": "整数"},
    {"名": "邮箱", "类型": "邮箱"},
    {"名": "类别", "类型": "选项", "选项们": ["技术", "生活", "随想"]}
]

令 结果 = {}

令 好 = 网造.表单_校验(字段们, {"标题": "你好", "浏览数": "42", "邮箱": "a@b.com", "类别": "技术"})
结果["好_有效"] = 好["有效"]
结果["好_清洗"] = 好["清洗"]

令 坏 = 网造.表单_校验(字段们, {"标题": "", "浏览数": "abc", "邮箱": "notanemail", "类别": "火星"})
结果["坏_有效"] = 坏["有效"]
结果["坏_错误"] = 坏["错误"]

结果["渲染"] = 网造.表单_渲染(字段们, "/save", "保存", {"标题": "预填", "类别": "生活"}, 坏["错误"])

令 目录 = 路径.临时目录("网造表单")
文件.写文本(路径.连接(目录, "result.json"), json.转文本(结果, 2))
打印("表单冒烟目录：" + 目录)