# 冒烟：会话 + 中间件（模拟两次带 Cookie 的请求，验证会话计数累加）
导入 网络服务营造 从 本地包 为 网造
导入 文件
导入 路径
导入 json

网造.中间件_清空()
网造.中间件_加(网造.会话_中间件())

函数 视图计数(请求, 参数):
    请求.会话["次数"] = 请求.会话.获取("次数", 0) + 1
    返回 网造.JSON响应({"次数": 请求.会话["次数"]})

# 从响应的 Set-Cookie 里取出 sessionid
函数 取会话号(响应):
    遍历 c 在 响应.cookie们:
        如果 c.开头是("Set-Cookie: sessionid="):
            令 段 = c.拆分(";")
            令 kv = 段[0].拆分("=")
            返回 kv[1]
    返回 ""

令 结果 = {}

# 第一次请求（无 Cookie）
令 req1 = 网造.请求("GET", "/")
令 r1 = 网造.中间件_执行(req1, 视图计数, {})
令 sid = 取会话号(r1)
结果["第一次"] = r1.内容
结果["拿到会话号"] = (sid != "")

# 第二次请求（带上 Cookie）
令 req2 = 网造.请求("GET", "/", 空, "", {"Cookie": "sessionid=" + sid})
令 r2 = 网造.中间件_执行(req2, 视图计数, {})
结果["第二次"] = r2.内容

# 第三次（再带同一 Cookie）
令 req3 = 网造.请求("GET", "/", 空, "", {"Cookie": "sessionid=" + sid})
令 r3 = 网造.中间件_执行(req3, 视图计数, {})
结果["第三次"] = r3.内容

令 目录 = 路径.临时目录("网造会话")
文件.写文本(路径.连接(目录, "result.json"), json.转文本(结果, 2))
打印("会话冒烟目录：" + 目录)