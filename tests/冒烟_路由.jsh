# 冒烟：路由（路径参数 / 转换 / 反查）
导入 网络服务营造 从 本地包 为 网造
导入 文件
导入 路径
导入 json

函数 首页(请求, 参数):
    返回 "首页"

函数 文章详情(请求, 参数):
    返回 "文章 " + 文本(参数["文章id"])

函数 归档(请求, 参数):
    返回 "归档 " + 参数["类别"] + " " + 文本(参数["编号"])

函数 文件路径(请求, 参数):
    返回 "文件 " + 参数["其余"]

令 表 = 新建 网造.路由表()
表.加("/", 首页, ["GET"], "首页")
表.加("/文章/<int:文章id>", 文章详情, ["GET"], "文章详情")
表.加("/归档/<slug:类别>/<int:编号>", 归档, ["GET"])
表.加("/文件/<path:其余>", 文件路径, ["GET"])

令 结果 = {}

令 m1 = 表.解析("GET", "/")
结果["m1_参数"] = m1["参数"]
结果["m1_是首页"] = (m1["处理"] == 首页)

令 m2 = 表.解析("GET", "/文章/42")
结果["m2_参数"] = m2["参数"]

令 m3 = 表.解析("GET", "/归档/tech/7")
结果["m3_参数"] = m3["参数"]

# 带尾斜杠、带中文
令 m4 = 表.解析("GET", "/文章/9/")
结果["m4_参数"] = m4["参数"]

# 不匹配
结果["m5_空"] = (表.解析("GET", "/不存在") == 空)

# 方法不匹配
结果["m6_方法不匹配"] = (表.解析("POST", "/文章/42") == 空)

# path 转换能吃斜杠
令 m7 = 表.解析("GET", "/文件/静态/a/b.css")
结果["m7_参数"] = m7["参数"]

# 反查
结果["rev_首页"] = 表.反转("首页")
结果["rev_文章"] = 表.反转("文章详情", {"文章id": 42})
结果["rev_文章_文本参数"] = 表.反转("文章详情", {"文章id": "7"})

# 路径们
结果["路径们"] = 表.路径们()

令 目录 = 路径.临时目录("网造路由")
文件.写文本(路径.连接(目录, "result.json"), json.转文本(结果, 2))
打印("路由冒烟目录：" + 目录)
