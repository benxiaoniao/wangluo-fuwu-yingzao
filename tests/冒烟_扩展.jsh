# 冒烟：扩展能力（JSON体 / 更多响应 / 405+HEAD / 跨域 / flash / 认证 / 模板注释+替换）
导入 网络服务营造 从 本地包 为 网造
导入 文件
导入 路径
导入 json

函数 视图OK(请求, 参数):
    返回 网造.文本响应("ok")

函数 取会话号(响应):
    遍历 c 在 响应.cookie们:
        如果 c.开头是("Set-Cookie: sessionid="):
            令 kv = c.拆分(";")[0].拆分("=")
            返回 kv[1]
    返回 ""

令 结果 = {}

# 1) 请求 JSON 体
令 jreq = 网造.请求("POST", "/", 空, "{\"标题\": \"测试\", \"浏览数\": 3}", {"Content-Type": "application/json"})
结果["JSON体"] = jreq.取JSON()

# 2) 响应便捷
结果["无内容状态"] = 网造.无内容().状态
结果["未授权状态"] = 网造.未授权().状态
结果["禁止状态"] = 网造.禁止().状态
结果["永久重定向状态"] = 网造.永久重定向("/x").状态
令 dl = 网造.文件下载("数据", "报表.txt")
结果["下载头"] = dl.头.获取("Content-Disposition", "")
结果["方法不允许状态"] = 网造.方法不允许(["GET", "POST"]).状态
结果["方法不允许Allow"] = 网造.方法不允许(["GET", "POST"]).头.获取("Allow", "")

# 3) 核心：405 与 HEAD
令 路由 = 新建 网造.路由表()
路由.加("/", 视图OK, ["GET"], "首页")
令 配置 = 网造.核心_默认配置()
配置["路由"] = 路由
配置["静态目录"] = "不存在的目录"
令 r405 = 网造.核心_分发(配置, {"方法": "POST", "路径": "/", "查询": {}, "请求头": {}, "正文": "", "版本": "HTTP/1.1"})
结果["405"] = r405.开头是("HTTP/1.1 405")
结果["405Allow"] = 结果["405"] 与 ("Allow: GET" 在 r405)
令 rhead = 网造.核心_分发(配置, {"方法": "HEAD", "路径": "/", "查询": {}, "请求头": {}, "正文": "", "版本": "HTTP/1.1"})
结果["HEAD"] = rhead.开头是("HTTP/1.1 200")
结果["HEAD无体"] = rhead.结尾是(字符(13) + 字符(10) + 字符(13) + 字符(10))

# 4) 跨域中间件
网造.中间件_清空()
网造.中间件_加(网造.中间件_跨域())
令 ro = 网造.中间件_执行(网造.请求("OPTIONS", "/"), 视图OK, {})
结果["OPTIONS状态"] = ro.状态
结果["OPTIONS_ACAO"] = ro.头.获取("Access-Control-Allow-Origin", "")
令 rg = 网造.中间件_执行(网造.请求("GET", "/"), 视图OK, {})
结果["GET_ACAO"] = rg.头.获取("Access-Control-Allow-Origin", "")

# 5) flash 提示（存会话、取一次即清）
网造.中间件_清空()
网造.中间件_加(网造.会话_中间件())
函数 视图设提示(请求, 参数):
    网造.会话_设提示(请求, "成功", "发布成功")
    返回 网造.JSON响应({"ok": 真})
函数 视图取提示(请求, 参数):
    返回 网造.JSON响应({"提示": 网造.会话_取提示(请求)})
令 r1 = 网造.中间件_执行(网造.请求("GET", "/"), 视图设提示, {})
令 sid = 取会话号(r1)
令 r2 = 网造.中间件_执行(网造.请求("GET", "/", 空, "", {"Cookie": "sessionid=" + sid}), 视图取提示, {})
结果["flash第一次"] = r2.内容
令 r3 = 网造.中间件_执行(网造.请求("GET", "/", 空, "", {"Cookie": "sessionid=" + sid}), 视图取提示, {})
结果["flash第二次"] = r3.内容

# 6) 认证：口令哈希 + 登录/当前用户
令 存 = 网造.认证_哈希("密码123")
结果["校验对"] = 网造.认证_校验("密码123", 存)
结果["校验错"] = 网造.认证_校验("错密码", 存)
网造.中间件_清空()
网造.中间件_加(网造.会话_中间件())
函数 视图登录(请求, 参数):
    网造.认证_登录(请求, {"名": "小明"})
    返回 网造.JSON响应({"用户": 网造.认证_当前用户(请求), "已登录": 网造.认证_已登录(请求)})
令 rlogin = 网造.中间件_执行(网造.请求("GET", "/"), 视图登录, {})
结果["登录后"] = rlogin.内容

# 7) 模板：注释块 + 替换过滤器
结果["注释"] = 网造.模板_渲染("A{% 注释 %}被忽略{% 结束注释 %}B", {})
结果["替换"] = 网造.模板_渲染("{{ t|替换:世界:大家 }}", {"t": "你好世界"})

令 目录 = 路径.临时目录("网造扩展")
文件.写文本(路径.连接(目录, "result.json"), json.转文本(结果, 2))
打印("扩展冒烟目录：" + 目录)