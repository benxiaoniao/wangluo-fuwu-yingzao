# 冒烟：登录保护 / ORM 分页联表 / 文件上传
导入 网络服务营造 从 本地包 为 网造
导入 文件
导入 路径
导入 json
导入 编码

令 目录 = 路径.临时目录("网造扩展2")
令 结果 = {}

函数 取会话号(响应):
    遍历 c 在 响应.cookie们:
        如果 c.开头是("Set-Cookie: sessionid="):
            令 kv = c.拆分(";")[0].拆分("=")
            返回 kv[1]
    返回 ""

# ---------- 1) 登录保护 ----------
函数 视图登录(请求, 参数):
    网造.认证_登录(请求, {"名": "admin", "角色": "管理员"})
    返回 网造.JSON响应({"角色": 网造.认证_角色(请求)})

函数 视图守卫(请求, 参数):
    令 g = 网造.认证_守卫(请求, "/登录")
    如果 g != 空:
        返回 g
    返回 网造.文本响应("可以访问")

网造.中间件_清空()
网造.中间件_加(网造.会话_中间件())
令 r1 = 网造.中间件_执行(网造.请求("GET", "/后台/"), 视图守卫, {})
结果["守卫_未登录状态"] = r1.状态
结果["守卫_未登录Location"] = r1.头.获取("Location", "")
令 rlogin = 网造.中间件_执行(网造.请求("GET", "/登录"), 视图登录, {})
令 sid = 取会话号(rlogin)
结果["登录角色"] = rlogin.内容
令 r2 = 网造.中间件_执行(网造.请求("GET", "/后台/", 空, "", {"Cookie": "sessionid=" + sid}), 视图守卫, {})
结果["守卫_已登录"] = r2.内容

# ---------- 2) ORM 分页 / 联表 ----------
网造.模型_设库(路径.连接(目录, "orm.db"))
网造.模型_定义("分类", ["名称"])
网造.模型_定义("文章", ["标题", "分类id"])
网造.模型_定义("项", ["名"])
网造.模型_迁移()

令 c1 = 网造.模型_创建("分类", {"名称": "技术"})
令 c2 = 网造.模型_创建("分类", {"名称": "生活"})
网造.模型_创建("文章", {"标题": "文章甲", "分类id": c1})
网造.模型_创建("文章", {"标题": "文章乙", "分类id": c2})
网造.模型_创建("文章", {"标题": "文章丙", "分类id": c1})
令 联 = 网造.模型_联表("文章", "id", "分类", "分类id")
结果["联表"] = 联.映射(函数(x): x["标题"] + "→" + x["_分类"][0]["名称"])

循环 25 次:
    网造.模型_创建("项", {"名": "项"})
令 p1 = 网造.模型_分页("项", 1, 10)
结果["分页1"] = {"总数": p1["总数"], "本页": 长度(p1["记录们"]), "总页": p1["总页数"], "有下一": p1["有下一页"]}
令 p3 = 网造.模型_分页("项", 3, 10)
结果["分页3"] = {"本页": 长度(p3["记录们"]), "有上一": p3["有上一页"], "有下一": p3["有下一页"]}

# ---------- 3) 文件上传 ----------
令 界 = "----网造边界"
令 CRLF = 字符(13) + 字符(10)
令 正文 = ("--" + 界 + CRLF
    + "Content-Disposition: form-data; name=\"标题\"" + CRLF + CRLF
    + "上传的标题" + CRLF
    + "--" + 界 + CRLF
    + "Content-Disposition: form-data; name=\"文件\"; filename=\"a.txt\"" + CRLF
    + "Content-Type: text/plain" + CRLF + CRLF
    + "文件内容ABC" + CRLF
    + "--" + 界 + "--" + CRLF)
令 上传请求 = 网造.请求("POST", "/上传", 空, 正文, {"Content-Type": "multipart/form-data; boundary=" + 界})
令 上传 = 网造.上传_解析(上传请求)
结果["上传_标题"] = 上传["字段们"].获取("标题", "")
结果["上传_文件名"] = 上传["文件们"][0]["文件名"]
结果["上传_内容"] = 上传["文件们"][0]["内容"]
令 保存路径 = 网造.上传_保存(上传["文件们"][0], 目录, [".txt"])
结果["上传_保存存在"] = 文件.文件存在(保存路径)
结果["上传_保存内容"] = 文件.读文本(保存路径)
令 允不允许 = 假
尝试:
    网造.上传_保存(上传["文件们"][0], 目录, [".png"])
捕获 异常 为 e:
    允不允许 = 真
结果["上传_类型校验"] = 允不允许
令 b64路径 = 网造.上传_保存base64(网造.内建_文本(编码.base64编码(编码.文本字节("二进制"))), 目录)
结果["上传_base64存在"] = 文件.文件存在(b64路径)

# dataURL 图片保存（1x1 PNG）
令 小图 = "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+M8AAAMBAQDJ/pLvAAAAAElFTkSuQmCC"
令 sp = 网造.上传_保存dataurl(小图, 目录)
结果["dataurl_类型"] = sp["类型"]
结果["dataurl_扩展"] = sp["扩展"]
结果["dataurl_存在"] = 文件.文件存在(sp["路径"])
结果["dataurl_预览保留"] = (sp["预览"] == 小图)

# ---------- 4) 静态文件：二进制直出 + 路径穿越防护（0.3.6） ----------
令 静态目录 = 路径.连接(目录, "静态")
文件.创建目录(静态目录)
文件.写字节(路径.连接(静态目录, "小.png"), 编码.十六进制解码("89504e470d0a1a0a"))
文件.写文本(路径.连接(静态目录, "样式.css"), "body{margin:0}")
令 静配置 = {"静态前缀": "/静态/", "静态目录": 静态目录}
# 二进制：内容应是原始字节（走字节通道）
令 sr = 网造.核心_静态(静配置, 网造.请求("GET", "/静态/小.png"))
结果["静态_图片类型"] = sr.内容类型
结果["静态_图片内容hex"] = 编码.十六进制编码(sr.内容)
# 文本类：照旧读文本
令 st = 网造.核心_静态(静配置, 网造.请求("GET", "/静态/样式.css"))
结果["静态_文本内容"] = st.内容
# 穿越：.. 与反斜杠一律 404（路径.连接 会保留 ..，文件存在 能解析出去，实测能读到源码）
令 sv1 = 网造.核心_静态(静配置, 网造.请求("GET", "/静态/../manage.jsh"))
令 sv2 = 网造.核心_静态(静配置, 网造.请求("GET", "/静态/..\\manage.jsh"))
结果["静态_穿越正斜杠404"] = (sv1.状态 == 404)
结果["静态_穿越反斜杠404"] = (sv2.状态 == 404)
# 未知扩展按字节直出（不再按文本读，避免二进制被重编码）
文件.写字节(路径.连接(静态目录, "数据.xyz"), 编码.十六进制解码("fffe01"))
令 su = 网造.核心_静态(静配置, 网造.请求("GET", "/静态/数据.xyz"))
结果["静态_未知扩展类型"] = su.内容类型
结果["静态_未知扩展hex"] = 编码.十六进制编码(su.内容)

文件.写文本(路径.连接(目录, "result.json"), json.转文本(结果, 2))
打印("扩展2冒烟目录：" + 目录)