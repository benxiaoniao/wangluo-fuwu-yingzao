# 冒烟：模板引擎
导入 网络服务营造 从 本地包 为 网造
导入 文件
导入 路径
导入 json

令 目录 = 路径.临时目录("网造模板")
网造.模板_设目录(目录)

文件.写文本(路径.连接(目录, "base.html"), "<!DOCTYPE html><html><head><title>{% 块 标题 %}默认标题{% 结束块 %}</title></head><body>{% 块 内容 %}默认内容{% 结束块 %}</body></html>")
文件.写文本(路径.连接(目录, "partial.html"), "<p>局部：{{ 名字 }}</p>")
文件.写文本(路径.连接(目录, "page.html"), "{% 继承 \"base.html\" %}{% 块 标题 %}{{ 标题 }}{% 结束块 %}{% 块 内容 %}<h1>{{ 标题 }}</h1>{% 包含 \"partial.html\" %}{% 结束块 %}")

令 结果 = {}

结果["继承"] = 网造.模板_渲染文件("page.html", {"标题": "<重要>", "名字": "世界"})
结果["转义"] = 网造.模板_渲染("{{ 内容 }}", {"内容": "<b>&"})
结果["安全"] = 网造.模板_渲染("{{ 内容|安全 }}", {"内容": "<b>&"})
结果["长度"] = 网造.模板_渲染("{{ 列表|长度 }}", {"列表": [1, 2, 3]})
结果["默认"] = 网造.模板_渲染("{{ 空值|默认:\"无\" }}", {"空值": ""})
结果["上限"] = 网造.模板_渲染("{{ 文本|上限:5 }}", {"文本": "一二三四五六七八"})

令 t_if = "{% 如果 分数 >= 90 %}优{% 否则如果 分数 >= 60 %}良{% 否则 %}差{% 结束如果 %}"
结果["如果_优"] = 网造.模板_渲染(t_if, {"分数": 95})
结果["如果_良"] = 网造.模板_渲染(t_if, {"分数": 70})
结果["如果_差"] = 网造.模板_渲染(t_if, {"分数": 50})

令 t_for = "{% 遍历 x 在 列表 %}[{{ x }}]{% 空 %}（空）{% 结束遍历 %}"
结果["遍历"] = 网造.模板_渲染(t_for, {"列表": ["甲", "乙"]})
结果["遍历空"] = 网造.模板_渲染(t_for, {"列表": []})

令 t_dict = "{% 遍历 文章 在 文章列表 %}{{ 文章.标题 }}；{% 结束遍历 %}"
结果["遍历字典"] = 网造.模板_渲染(t_dict, {"文章列表": [{"标题": "一"}, {"标题": "二"}]})
结果["点取值"] = 网造.模板_渲染("{{ 文章.作者.名字 }}", {"文章": {"作者": {"名字": "小明"}}})
结果["文本比较"] = 网造.模板_渲染("{% 如果 姓名 < 'Z' %}靠前{% 否则 %}靠后{% 结束如果 %}", {"姓名": "A"})
结果["文本比较2"] = 网造.模板_渲染("{% 如果 姓名 > 'Z' %}靠前{% 否则 %}靠后{% 结束如果 %}", {"姓名": "A"})

文件.写文本(路径.连接(目录, "result.json"), json.转文本(结果, 2))
打印("模板冒烟目录：" + 目录)