# 冒烟：管理后台（登录门槛 / 列表 / 新建 / 编辑 / 删除）
导入 网络服务营造 从 本地包 为 网造
导入 文件
导入 路径
导入 json

令 目录 = 路径.临时目录("网造后台")
令 结果 = {}

网造.模型_设库(路径.连接(目录, "admin.db"))
网造.模型_定义("文章", ["标题", "正文"])
网造.模型_迁移()
网造.模型_创建("文章", {"标题": "文章甲", "正文": "内容甲"})
网造.模型_创建("文章", {"标题": "文章乙", "正文": "内容乙"})

网造.后台_配置({"标题": "测试后台", "用户": "admin", "口令": "secret", "每页": 1})

# 路由层：后台_挂载 后各路径能被正确解析（含去尾斜杠）
令 路由 = 新建 网造.路由表()
网造.后台_挂载(路由, "/后台")
结果["路由_首页"] = (路由.解析("GET", "/后台/") != 空)
令 h = 路由.解析("GET", "/后台/文章/")
结果["路由_列表"] = (h != 空) 与 (h["参数"].获取("模型", "") == "文章")
结果["路由_新建"] = (路由.解析("GET", "/后台/文章/新建") != 空)
令 e = 路由.解析("GET", "/后台/文章/5")
结果["路由_编辑"] = (e != 空) 与 (e["参数"].获取("id", 0) == 5)
结果["路由_删除"] = (路由.解析("POST", "/后台/文章/5/删除") != 空)
结果["路由_登录"] = (路由.解析("GET", "/后台/登录") != 空)

函数 取会话号(响应):
    遍历 c 在 响应.cookie们:
        如果 c.开头是("Set-Cookie: sessionid="):
            令 kv = c.拆分(";")[0].拆分("=")
            返回 kv[1]
    返回 ""

函数 跑(方法, 路径, 视图, 参数, cookie, 正文):
    令 头 = {}
    如果 cookie != "":
        头["Cookie"] = "sessionid=" + cookie
    如果 正文 != "":
        头["Content-Type"] = "application/x-www-form-urlencoded"
    令 req = 网造.请求(方法, 路径, 空, 正文, 头)
    返回 网造.中间件_执行(req, 视图, 参数)

网造.中间件_清空()
网造.中间件_加(网造.会话_中间件())

# 未登录访问首页 → 302
令 r0 = 跑("GET", "/后台/", 网造.后台_首页, {}, "", "")
结果["未登录首页"] = r0.状态

# 登录
令 rlogin = 跑("POST", "/后台/登录", 网造.后台_登录, {}, "", "口令=secret")
令 sid = 取会话号(rlogin)
结果["登录状态"] = rlogin.状态
结果["拿到会话"] = (sid != "")

# 已登录首页
令 r1 = 跑("GET", "/后台/", 网造.后台_首页, {}, sid, "")
结果["已登录首页"] = r1.状态
结果["首页含模型"] = r1.内容.包含("文章")

# 列表（每页1条 → 两页）
令 rl = 跑("GET", "/后台/文章/", 网造.后台_列表, {"模型": "文章"}, sid, "")
结果["列表状态"] = rl.状态
结果["列表含文章乙"] = rl.内容.包含("文章乙")
结果["列表有分页"] = rl.内容.包含("下一页")

# 搜索（关键词=甲 → 只剩含“甲”的）
令 req_s = 网造.请求("GET", "/后台/文章/", {"关键词": "甲"}, "", {"Cookie": "sessionid=" + sid})
令 rs = 网造.中间件_执行(req_s, 网造.后台_列表, {"模型": "文章"})
结果["搜索_含甲"] = rs.内容.包含("文章甲")
结果["搜索_不含乙"] = 非 rs.内容.包含("文章乙")

# 排序（按标题降序 → 表头有 ↓ 箭头）
令 req_sort = 网造.请求("GET", "/后台/文章/", {"排序": "标题", "倒序": "1"}, "", {"Cookie": "sessionid=" + sid})
令 rt = 网造.中间件_执行(req_sort, 网造.后台_列表, {"模型": "文章"})
结果["排序_降箭头"] = rt.内容.包含("↓")

# 关联列：员工.部门id -> 部门.名称（列表里显示“研发部”而非裸 id）
网造.模型_定义("部门", ["名称"])
网造.模型_定义("员工", ["姓名", "部门id"])
网造.模型_迁移()
令 d1 = 网造.模型_创建("部门", {"名称": "研发部"})
网造.模型_创建("员工", {"姓名": "张三", "部门id": d1})
网造.后台_配置({"关系": {"员工": {"部门id": ["部门", "名称"]}}})
令 req_e = 网造.请求("GET", "/后台/员工/", {}, "", {"Cookie": "sessionid=" + sid})
令 re = 网造.中间件_执行(req_e, 网造.后台_列表, {"模型": "员工"})
结果["关联_显示研发部"] = re.内容.包含("研发部")

# 关联编辑下拉：新建页有 <select> 且列出“研发部”
令 req_ne = 网造.请求("GET", "/后台/员工/新建", {}, "", {"Cookie": "sessionid=" + sid})
令 rne = 网造.中间件_执行(req_ne, 网造.后台_新建, {"模型": "员工"})
结果["关联下拉_有select"] = rne.内容.包含("<select")
结果["关联下拉_含研发部"] = rne.内容.包含("研发部")

# 关联编辑下拉：编辑页当前关联项被 selected
令 员工 = 网造.模型_取("员工", {"姓名": "张三"})
令 req_ed = 网造.请求("GET", "/后台/员工/" + 文本(员工["id"]), {}, "", {"Cookie": "sessionid=" + sid})
令 red = 网造.中间件_执行(req_ed, 网造.后台_编辑, {"模型": "员工", "id": 员工["id"]})
结果["关联编辑_selected"] = red.内容.包含("selected")

# 新建 GET
令 rng = 跑("GET", "/后台/文章/新建", 网造.后台_新建, {"模型": "文章"}, sid, "")
结果["新建GET"] = rng.状态
结果["新建GET有表单"] = rng.内容.包含("<form")

# 新建 POST
令 rnp = 跑("POST", "/后台/文章/新建", 网造.后台_新建, {"模型": "文章"}, sid, "标题=文章丙&正文=内容丙")
结果["新建POST"] = rnp.状态
结果["新建后计数"] = 网造.模型_计数("文章")

# 编辑 POST（把 文章甲 改成 文章甲改）
令 甲 = 网造.模型_取("文章", {"标题": "文章甲"})
令 red = 跑("POST", "/后台/文章/" + 文本(甲["id"]), 网造.后台_编辑, {"模型": "文章", "id": 甲["id"]}, sid, "标题=文章甲改&正文=内容甲")
结果["编辑POST"] = red.状态
结果["编辑后标题"] = 网造.模型_取ID("文章", 甲["id"])["标题"]

# 删除 POST（删 文章乙）
令 乙 = 网造.模型_取("文章", {"标题": "文章乙"})
令 rdel = 跑("POST", "/后台/文章/" + 文本(乙["id"]) + "/删除", 网造.后台_删除, {"模型": "文章", "id": 乙["id"]}, sid, "")
结果["删除POST"] = rdel.状态
结果["删除后计数"] = 网造.模型_计数("文章")
结果["删除后标题们"] = 网造.模型_列("文章", "标题")

# 导出 CSV
令 req_csv = 网造.请求("GET", "/后台/文章/导出", {}, "", {"Cookie": "sessionid=" + sid})
令 rcsv = 网造.中间件_执行(req_csv, 网造.后台_导出CSV, {"模型": "文章"})
结果["CSV_状态"] = rcsv.状态
结果["CSV_有标题列"] = rcsv.内容.包含("标题")
结果["CSV_有BOM"] = (rcsv.内容[0] == 字符(65279))

# 批量删除（删 文章丙）
令 丙 = 网造.模型_取("文章", {"标题": "文章丙"})
令 前 = 网造.模型_计数("文章")
令 req_bd = 网造.请求("POST", "/后台/文章/批量删除", {}, "ids=" + 文本(丙["id"]), {"Cookie": "sessionid=" + sid, "Content-Type": "application/x-www-form-urlencoded"})
令 rbd = 网造.中间件_执行(req_bd, 网造.后台_批量删除, {"模型": "文章"})
结果["批量删除_状态"] = rbd.状态
结果["批量删除_少一条"] = (网造.模型_计数("文章") == 前 - 1)

# 图片管理（列表 / 删除）
令 图片目录 = 路径.连接(目录, "图片")
文件.创建目录(图片目录)
网造.后台_配置({"上传目录": 图片目录})
网造.上传_写索引(图片目录, [{"名": "测试.png", "预览": "data:image/png;base64,AAAA", "路径": 路径.连接(图片目录, "不存在.png")}])
令 req_img = 网造.请求("GET", "/后台/图片", {}, "", {"Cookie": "sessionid=" + sid})
令 rimg = 网造.中间件_执行(req_img, 网造.后台_图片列表, {})
结果["图片_列表"] = rimg.内容.包含("图片卡") 与 rimg.内容.包含("测试.png")
令 req_imgd = 网造.请求("POST", "/后台/图片/删除", {}, "名=测试.png", {"Cookie": "sessionid=" + sid, "Content-Type": "application/x-www-form-urlencoded"})
令 rimgd = 网造.中间件_执行(req_imgd, 网造.后台_图片删除, {})
结果["图片_删除后空"] = (长度(网造.上传_读索引(图片目录)) == 0)

文件.写文本(路径.连接(目录, "result.json"), json.转文本(结果, 2))
打印("后台冒烟目录：" + 目录)